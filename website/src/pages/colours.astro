---
// One palette: every colour 0001's products use, named by its colour and sorted by hue, greys last.
// Each has a dark-mode version, derived the way the ds1 Figma file derives Apple green's
// (#99ff73 → #529d36): the same hue, about half the saturation, at 41% lightness. Greys turn over.
// Where each colour is used is in the design-system-1 skill (skills/design-system-1/SKILL.md).
import { PRODUCTS, drawingSvg } from '../lib/icons/studio';
import '../styles/icons/studio.css';

// The palette's colours; each also gets a pastel and a dark version below.
const named: [string, string][] = [
  ['Tuned red', '#ff5f5f'], ['Signal red', '#ff4438'], ['Red for blood', '#de0331'], ['Dark red variant', '#c50124'],
  ['Orange', '#fec20d'], ['Old gold', '#b69e55'], ['Sand', '#dbc88f'], ['Drip yellow', '#fde70c'], ['Yellow', '#eaff00'],
  ['Every green', '#979441'], ['Chartreuse', '#ccff4d'], ['Apple green', '#99ff73'], ['Metal green', '#026d5b'],
  ['Hysteric blue', '#69d8fb'], ['Winning blue', '#0275fa'], ['Sharp blue', '#594dff'], ['Purple', '#e63aaf'], ['Pink', '#f5aad1'],
  ['White', '#ffffff'], ['Egg', '#f9f6ef'], ['Light grey', '#e8e8e8'], ['Slate light', '#e6e6e6'], ['Darker grey', '#797979'],
  ['Stealth', '#554455'], ['Slate dark', '#3c3c3c'], ['Ink', '#2c2c2b'], ['Black', '#2a2a2a'], ['Slate', '#1e1e1e'],
];
// Pastels that already have a name and a token keep them.
const namedPastels: Record<string, [string, string]> = { 'Sharp blue': ['Zenith blue', '#ccccff'], Chartreuse: ['Comfortable green', '#f2ffcf'] };

function toHsl(hex: string): [number, number, number] {
  const [r, g, b] = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255);
  const max = Math.max(r, g, b); const min = Math.min(r, g, b); const l = (max + min) / 2;
  if (max === min) return [0, 0, l];
  const d = max - min; const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
  const h = max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
  return [h * 60, s, l];
}
function toHex(h: number, s: number, l: number): string {
  const a = s * Math.min(l, 1 - l);
  const f = (n: number) => { const k = (n + h / 30) % 12; return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))).toString(16).padStart(2, '0'); };
  return `#${f(0)}${f(8)}${f(4)}`;
}
const grey = ([, s, l]: [number, number, number]) => s < 0.15 || l > 0.95;
function dark(hex: string): string {
  const [h, s, l] = toHsl(hex);
  if (grey([h, s, l])) return toHex(h, s, 0.12 + (1 - l) * 0.76);
  return toHex(h, l > 0.41 ? s * 0.49 : s, 0.41);
}
const slug = (name: string) => '--' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
// A pastel keeps the colour's hue and saturation at 90% lightness.
function pastel(hex: string): string { const [h, s] = toHsl(hex); return toHex(h, s, 0.9); }
// In dark mode a pastel's job, a quiet tint behind things, is done by a dim version at 20% lightness.
function darkPastel(hex: string): string { const [h, s] = toHsl(hex); return toHex(h, s * 0.49, 0.2); }
const colours = named
  .map(([name, hex]) => ({ name, hex, dark: dark(hex), hsl: toHsl(hex), token: slug(name), pastel: namedPastels[name]?.[1] || pastel(hex), pastelName: namedPastels[name]?.[0] || `${name} pastel`, darkPastel: darkPastel(hex) }))
  .sort((a, b) => {
    const ga = grey(a.hsl); const gb = grey(b.hsl);
    if (ga !== gb) return ga ? 1 : -1;
    if (ga) return b.hsl[2] - a.hsl[2];
    const hue = Math.round(a.hsl[0] / 15) - Math.round(b.hsl[0] / 15);
    return hue || b.hsl[2] - a.hsl[2];
  });
const palette = colours.filter(c => !grey(c.hsl));
const inks = colours.filter(c => grey(c.hsl));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Colours — Design System 1</title>
    <meta name="description" content="One palette for every 0001 product, each colour with a dark-mode version." />
    <link rel="canonical" href="https://designsystem1.com/colours" />
    <link rel="icon" type="image/svg+xml" href="/icons/design-system-1.svg" />
    <script is:inline src="/google-analytics.js" defer></script>
    <style>
      /* On the 20px square: a swatch is eight squares wide, light and dark halves of four, three squares high; 14px text on 20px lines. */
      .colours { padding-bottom: 80px; }
      .colours section { margin-top: 40px; }
      .colours h2 { margin: 0 0 20px; font-size: 14px; line-height: 20px; font-weight: 500; letter-spacing: 0; }
      .swatches { display: grid; grid-template-columns: repeat(auto-fill, 160px); gap: 20px; margin: 0; padding: 0; list-style: none; }
      .swatch { font-size: 14px; line-height: 20px; }
      .swatch-pair { display: grid; grid-template-columns: 1fr 1fr; height: 60px; margin: 4px 0; border-radius: 4px; overflow: hidden; }
      .swatch b { display: block; font-weight: 500; }
      .swatch-one { display: block; height: 60px; margin: 4px 0; border-radius: 4px; overflow: hidden; }
      .swatch-one i, .swatch-pair i { display: block; height: 100%; }
      .hexes { display: grid; grid-template-columns: 80px 80px; }
      .mode-tabs { display: flex; gap: 0; margin-top: 20px; }
      .mode-tabs button { height: 20px; padding: 0 4px; border: 0; border-radius: 0; font-size: 14px; line-height: 20px; color: var(--muted); }
      .mode-tabs button[aria-selected=true] { color: inherit; text-decoration: underline; text-underline-offset: 4px; }
      .mode { margin-top: 20px; padding: 0 20px 40px; }
      .mode.dark { background: #1e1e1e; color: #e6e6e6; }
      .mode.dark .swatch code { color: #b3b3b3; }
      .mode section:first-child { padding-top: 20px; margin-top: 0; }
      .swatch code { display: block; font-size: 12px; line-height: 20px; color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="studio-header">
      <a href="/" class="wordmark"><span class="brand-mark" set:html={drawingSvg(PRODUCTS[0], 24, 'brand')} />Design system 1</a>
      <nav aria-label="Main"><a href="/getting-started/installation/">Documentation</a><a href="/classless/editor/">CLASSless</a><a href="/icons">Icons</a><a href="/colours" aria-current="page">Colours <span class="nav-dot"></span></a></nav>
    </header>
    <main class="colours">
      <section class="intro"><h1>Colours<span class="green-dot">.</span></h1></section>
      <div class="mode-tabs" role="tablist" aria-label="Mode"><button role="tab" id="tab-light" aria-controls="light" aria-selected="true">Light</button><button role="tab" id="tab-dark" aria-controls="dark" aria-selected="false" tabindex="-1">Dark</button></div>
      {[['light', 'Light'], ['dark', 'Dark']].map(([mode]) => (
        <div id={mode} class={`mode ${mode}`} role="tabpanel" aria-labelledby={`tab-${mode}`} hidden={mode === 'dark'}>
          <section>
            <h2>Palette</h2>
            <ul class="swatches">{palette.map(c => {
              const [main, soft] = mode === 'light' ? [c.hex, c.pastel] : [c.dark, c.darkPastel];
              return <li class="swatch"><b>{c.name}</b><span class="swatch-pair"><i style={`background:${main}`} title={`${mode === 'light' ? c.name : `${c.name} dark`} ${main}`}></i><i style={`background:${soft}`} title={`${mode === 'light' ? c.pastelName : `${c.name} dim`} ${soft}`}></i></span></li>;
            })}</ul>
          </section>
          <section>
            <h2>Inks</h2>
            <ul class="swatches">{inks.map(c => { const v = mode === 'light' ? c.hex : c.dark; return <li class="swatch"><b>{c.name}</b><span class="swatch-one"><i style={`background:${v}`} title={`${c.name} ${v}`}></i></span></li>; })}</ul>
          </section>
        </div>
      ))}
      <script is:inline>
        const tabs = [...document.querySelectorAll('.mode-tabs [role=tab]')];
        const show = tab => tabs.forEach(t => { const on = t === tab; t.setAttribute('aria-selected', on); t.tabIndex = on ? 0 : -1; document.getElementById(t.getAttribute('aria-controls')).hidden = !on; });
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => show(tab));
          tab.addEventListener('keydown', e => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]; show(next); next.focus(); } });
        });
      </script>
    </main>
  </body>
</html>
