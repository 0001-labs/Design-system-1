---
// The colours of Design system 1, and where 0001's products use them. Mirrors the Colours section of the
// design-system-1 skill (skills/design-system-1/SKILL.md); change both together.
import { PRODUCTS, drawingSvg } from '../lib/icons/studio';
import '../styles/icons/studio.css';

const palette = [
  ['--apple-green', '#99ff73', 'Apple green', 'The default accent'],
  ['--chartreuse-green', '#ccff4d', 'Chartreuse', "The 0001 site's accent"],
  ['--every-green', '#979441', 'Every green', 'Olive'],
  ['--yellow', '#eaff00', 'Yellow', ''],
  ['--orange', '#fec20d', 'Orange', ''],
  ['--tuned-red', '#ff5f5f', 'Tuned red', ''],
  ['--pink', '#f5aad1', 'Pink', ''],
  ['--zenith-blue', '#ccccff', 'Zenith blue', ''],
  ['--sharp-blue', '#594dff', 'Sharp blue', ''],
];
const neutrals = [
  ['--slate', '#1e1e1e', 'Slate', 'The ink'],
  ['--black', '#2a2a2a', 'Black', 'Dark paper, and text in light mode'],
  ['--slate-dark', '#3c3c3c', 'Slate dark', 'Controls on dark paper'],
  ['--stealth', '#554455', 'Stealth', ''],
  ['--base-darker-grey', '#797979', 'Darker grey', 'Muted text'],
  ['--slate-light', '#e6e6e6', 'Slate light', 'Controls and outlines on light paper'],
  ['--light-grey', '#e8e8e8', 'Light grey', ''],
];
const ezoAccents = ['#99ff73', '#979441', '#ccccff', '#594dff', '#f5aad1', '#ff5f5f', '#fec20d', '#eaff00'];
const diagrams = [['light-green', '#99ff73'], ['light-blue', '#ccccff'], ['pink', '#f5aad1'], ['yellow', '#eaff00'], ['orange', '#fec20d'], ['red', '#ff5f5f'], ['white', '#e8e8e8']];
const tau99 = [['--brand', '#f2ffcf', 'The 0001 site (--tau99-brand) and Link (--color-tau99) already use it'], ['--cart-badge-bg-logged-in', '#d8ff94', 'Only in tau99'], ['--cart-badge-bg', '#ebb208', 'Only in tau99']];
const notion = [['Blue, purple', '#ccccff'], ['Green', '#99ff73'], ['Chartreuse', '#ccff4d'], ['Yellow', '#f3ff99'], ['Orange', '#ffd199'], ['Red', '#ffb3a7'], ['Pink', '#ffc7e8'], ['Grey', '#e8e8e8']];
const hashed = ['#ccff4d', '#8bd3ff', '#ffd166', '#ff9f9f', '#c7b9ff', '#7ee0c3', '#f7a1d7', '#f3ff99', '#ffbf80', '#a8e6cf', '#b8f2ff', '#e6c7ff'];
const inPalette = new Set([...palette, ...neutrals].map(([, hex]) => hex));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Colours — Design System 1</title>
    <meta name="description" content="The Design System 1 palette, and how Ezo, tau99 and Link use it." />
    <link rel="canonical" href="https://designsystem1.com/colours" />
    <link rel="icon" type="image/svg+xml" href="/icons/design-system-1.svg" />
    <script is:inline src="/google-analytics.js" defer></script>
    <style>
      /* On the 20px square: swatches four squares wide and three high, 14px text on 20px lines, 1px lines. */
      .colours { padding-bottom: 80px; }
      .colours section { margin-top: 60px; }
      .colours h2 { margin: 0; font-size: 14px; line-height: 20px; font-weight: 500; letter-spacing: 0; }
      .colours h2 + p { margin: 0 0 20px; max-width: 720px; font-size: 14px; line-height: 20px; color: var(--muted); }
      .swatches { display: grid; grid-template-columns: repeat(auto-fill, 160px); gap: 20px; margin: 0; padding: 0; list-style: none; }
      .swatch { font-size: 14px; line-height: 20px; }
      .swatch i { display: block; height: 60px; border: 1px solid #1e1e1e1a; margin-bottom: 4px; }
      .swatch b { display: block; font-weight: 500; }
      .swatch code { display: block; }
      .swatch code, .chip code { font-size: 12px; line-height: 20px; color: var(--muted); }
      .swatch span { display: block; color: var(--muted); }
      .chips { display: flex; flex-wrap: wrap; gap: 0; margin: 0; padding: 0; list-style: none; }
      .chip { display: flex; align-items: center; gap: 4px; width: 160px; height: 20px; font-size: 14px; line-height: 20px; }
      .chip i { flex: none; width: 19px; height: 19px; border: 1px solid #1e1e1e1a; }
      .chip.outside i { border-radius: 50%; }
      .note { margin: 20px 0 0; max-width: 720px; font-size: 14px; line-height: 20px; color: var(--muted); }
      .note code { font-size: 12px; }
      .colours h3 { margin: 20px 0 0; font-size: 14px; line-height: 20px; font-weight: 500; }
    </style>
  </head>
  <body>
    <header class="studio-header">
      <a href="/" class="wordmark"><span class="brand-mark" set:html={drawingSvg(PRODUCTS[0], 24, 'brand')} />Design system 1</a>
      <nav aria-label="Main"><a href="/getting-started/installation/">Documentation</a><a href="/classless/editor/">CLASSless</a><a href="/icons">Icons</a><a href="/colours" aria-current="page">Colours <span class="nav-dot"></span></a></nav>
    </header>
    <main class="colours">
      <section class="intro">
        <div><p class="eyebrow">ONE PALETTE, EVERY PRODUCT</p><h1>Colours<span class="green-dot">.</span></h1></div>
        <p class="intro-copy">Every colour is a token in one.css.<br />Use the token, never the hex.</p>
      </section>

      <section aria-labelledby="palette">
        <h2 id="palette">The palette</h2>
        <p>Nine accents. Text and surfaces go through light-dark() tokens, so dark mode needs no second set.</p>
        <ul class="swatches">{palette.map(([token, hex, name, use]) => <li class="swatch"><i style={`background:${hex}`}></i><b>{name}</b><code>{token}</code><code>{hex}</code>{use && <span>{use}</span>}</li>)}</ul>
      </section>

      <section aria-labelledby="neutrals">
        <h2 id="neutrals">Ink and greys</h2>
        <p>The ink is slate. The grid's lines are slate at 17%, #1e1e1e2b.</p>
        <ul class="swatches">{neutrals.map(([token, hex, name, use]) => <li class="swatch"><i style={`background:${hex}`}></i><b>{name}</b><code>{token}</code><code>{hex}</code>{use && <span>{use}</span>}</li>)}</ul>
      </section>

      <section aria-labelledby="ezo">
        <h2 id="ezo">How Ezo uses it</h2>
        <p>A person picks one of eight accents in Settings, apple green by default, or none. A header item is painted in the accent and lettered in the ink it can carry.</p>
        <ul class="chips">{ezoAccents.map(hex => <li class="chip"><i style={`background:${hex}`}></i>{palette.find(([, h]) => h === hex)?.[2]}</li>)}</ul>
        <h3>Diagrams</h3>
        <ul class="chips">{diagrams.map(([name, hex]) => <li class="chip"><i style={`background:${hex}`}></i>{name}</li>)}</ul>
        <p class="note">On light paper, filled squares and chart lines mix the colour with the ink, about 85% colour, so they read on white. Lines that must stand out, as on the System map, take 70% accent and 30% ink, never the bare pale colour.</p>
      </section>

      <section aria-labelledby="tau99">
        <h2 id="tau99">From tau99, a candidate</h2>
        <p>tau99 has its own set. Its pale lime is already used by two products under two names, so it is the one worth adding to the library, as <code>--tau99</code>: a paper tint for selected rows and quiet panels.</p>
        <ul class="swatches">{tau99.map(([token, hex, use]) => <li class="swatch"><i style={`background:${hex}`}></i><b>{token}</b><code>{hex}</code><span>{use}</span></li>)}</ul>
      </section>

      <section aria-labelledby="link">
        <h2 id="link">Link's project colours</h2>
        <p>A project keeps one colour on the web and on iPhone, from <code>Link/shared/projectColors.ts</code>: its own colour if set, then its Notion colour, then one of twelve picked from its name. An ended subscription turns it grey. A round mark is a colour outside the palette.</p>
        <h3>From Notion</h3>
        <ul class="chips">{notion.map(([name, hex]) => <li class={`chip${inPalette.has(hex) ? '' : ' outside'}`}><i style={`background:${hex}`}></i>{name}</li>)}</ul>
        <h3>Picked from the name</h3>
        <ul class="chips">{hashed.map(hex => <li class={`chip${inPalette.has(hex) ? '' : ' outside'}`}><i style={`background:${hex}`}></i><code>{hex}</code></li>)}</ul>
        <p class="note">Only green, chartreuse and zenith blue are Design system 1 colours. Brought onto the system, Link would take its project colours from the palette, as tints, rather than its own pastels.</p>
      </section>
    </main>
  </body>
</html>
