---
// The four layers as bricks stacked on one another, the way Link's landing
// draws its bricks (Link's client/design/IsoBrick.astro): each a box seen from
// above at the same angle, its top and two sides filled in its layer's colour
// and outlined in the ink, the foundation at the bottom. Root holds Core, Core
// holds Unit, and Unit holds Page.
import { LAYERS } from '../lib/component-directory';

const FILLS: Record<string, string> = {
  white: '#ffffff',
  'light-green': '#99ff73',
  'light-blue': '#ccccff',
  pink: '#f5aad1',
};

// Bottom to top: the first layer is the foundation.
const bricks = LAYERS.map((layer, index) => ({
  label: `${layer.number} ${layer.name}`,
  fill: FILLS[layer.color] ?? '#e6e6e6',
  lift: index,
  top: index === LAYERS.length - 1,
}));
---

<figure class="layer-bricks" aria-label="The four layers as bricks, each standing on the one before: Root, Core, Unit and Page">
  <div class="layer-bricks-world" aria-hidden="true">
    {bricks.map((brick) => (
      <div class:list={['layer-brick', brick.top && 'layer-brick--top']} style={`--brick-fill: ${brick.fill}; --brick-lift: ${brick.lift}`}>
        <span class="layer-brick-face layer-brick-face--west"></span>
        <span class="layer-brick-face layer-brick-face--south"><span class="layer-brick-label">{brick.label}</span></span>
        <span class="layer-brick-face layer-brick-face--top"></span>
      </div>
    ))}
  </div>
</figure>

<style>
  .layer-bricks {
    /* Link's measures: a brick thirty pixels (a square and a half) tall and
       deep and four times that long, outlined in Link's ink. */
    --brick-unit: calc(1.5 * var(--landing-unit, 20px));
    --brick-long: calc(4 * var(--brick-unit));
    --brick-ink: #2c2c2b;
    display: grid;
    place-items: center;
    width: max-content;
    height: calc(7 * var(--brick-unit));
    margin: 0;
    padding-inline: var(--brick-unit);
  }
  .layer-bricks-world,
  .layer-brick {
    transform-style: preserve-3d;
  }
  /* The same view as Link's: tipped back sixty degrees and turned forty-five. */
  .layer-bricks-world {
    position: relative;
    width: var(--brick-long);
    height: var(--brick-unit);
    transform: translateY(calc(1 * var(--brick-unit))) rotateX(60deg) rotateZ(-45deg);
  }
  .layer-brick {
    position: absolute;
    inset: 0;
    transform: translateZ(calc(var(--brick-lift) * var(--brick-unit)));
  }
  .layer-brick-face {
    position: absolute;
    box-sizing: border-box;
    border: 1.5px solid var(--brick-ink);
    backface-visibility: hidden;
  }
  /* Only the topmost brick shows its top; below it each is covered by the next. */
  .layer-brick-face--top {
    inset: 0;
    background: color-mix(in srgb, var(--brick-fill) 88%, #fff);
    transform: translateZ(var(--brick-unit));
    visibility: hidden;
  }
  .layer-brick--top .layer-brick-face--top { visibility: visible; }
  .layer-brick-face--south {
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--brick-unit);
    display: flex;
    align-items: center;
    padding-inline: 9px;
    background: var(--brick-fill);
    transform: rotateX(-90deg);
    transform-origin: center bottom;
  }
  .layer-brick-face--west {
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--brick-unit);
    background: color-mix(in srgb, var(--brick-fill) 78%, #1b2430);
    transform: rotateY(-90deg);
    transform-origin: left center;
  }
  .layer-brick-label {
    color: var(--brick-ink);
    font-family: var(--typeface-regular);
    font-size: calc(1.05 * var(--landing-unit, 20px));
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
