---
import LandingHero from './LandingHero.astro';
import LayerDiagram from './LayerDiagram.astro';
import { LAYERS } from '../lib/component-directory';
---

<article class="landing" aria-labelledby="landing-title" data-pagefind-body>
  <LandingHero />
  <section id="learn-more" class="landing-layers" aria-label="The four layers">
    <LayerDiagram />
  </section>
  <div class="landing-directory" role="group" aria-label="Every component, by layer">
    {LAYERS.map((layer) => (
      <section class="directory-layer" data-color={layer.color} aria-labelledby={`layer-${layer.number}`}>
        <div class="directory-layer-head">
          <h2 id={`layer-${layer.number}`}><span class="directory-swatch" aria-hidden="true"></span>{layer.number} {layer.name}</h2>
          <p>{layer.summary}</p>
        </div>
        <ul>
          {layer.entries.map((entry) => (
            <li><a href={entry.href}>{entry.name}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</article>

<style>
  .landing {
    --landing-unit: min(calc(var(--unit, 20px) * var(--sf, 1)), calc(100vw / 57));
    --landing-type: calc(0.7 * var(--landing-unit));
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: none;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    padding-block: 0 calc(4 * var(--landing-unit));
    color: var(--ds1-docs-header-text);
  }
  .landing :is(h2, p) { margin: 0; }

  .landing-layers {
    display: grid;
    justify-items: start;
    margin-inline-start: calc(5 * var(--landing-unit));
    padding-block: calc(4 * var(--landing-unit));
    scroll-margin-top: 0;
  }

  /* Every component by layer: the layer's name and what it is beside its
     list, staying in view while the names go by. The names are the links,
     one a line, each six squares high. */
  .landing-directory {
    --directory-type: calc(6 * var(--landing-unit));
    margin-inline: calc(5 * var(--landing-unit));
    font-family: var(--typeface-regular);
  }
  .directory-layer {
    --layer-color: light-dark(#e6e6e6, #ffffff);
    display: grid;
    grid-template-columns: calc(10 * var(--landing-unit)) minmax(0, 1fr);
    column-gap: calc(2 * var(--landing-unit));
    row-gap: var(--landing-unit);
    padding-block: var(--landing-unit) calc(4 * var(--landing-unit));
    border-top: 1px solid var(--ds1-docs-divider, var(--ds1-docs-header-border));
  }
  .directory-layer[data-color='light-green'] { --layer-color: #99ff73; }
  .directory-layer[data-color='light-blue'] { --layer-color: #ccccff; }
  .directory-layer[data-color='pink'] { --layer-color: #f5aad1; }
  .directory-layer[data-color='yellow'] { --layer-color: #eaff00; }

  .directory-layer-head {
    position: sticky;
    top: calc(var(--site-header-height, 0px) + var(--landing-unit));
    align-self: start;
    font-size: var(--landing-type);
  }
  /* One square a line, the swatch and words on its lower sixteen. */
  .directory-layer-head h2 {
    display: flex;
    align-items: flex-end;
    gap: calc(0.2 * var(--landing-unit));
    height: var(--landing-unit);
    color: inherit;
    font-family: var(--typeface-medium);
    font-size: var(--landing-type);
    font-weight: 400;
    letter-spacing: 0;
    line-height: calc(0.8 * var(--landing-unit));
  }
  .directory-swatch {
    flex: none;
    width: calc(0.8 * var(--landing-unit));
    height: calc(0.8 * var(--landing-unit));
    background: var(--layer-color);
  }
  .directory-layer-head p {
    color: var(--ds1-docs-header-text-secondary);
    line-height: var(--landing-unit);
  }

  .directory-layer ul { margin: 0; padding: 0; list-style: none; }
  .directory-layer li { margin: 0; }
  .directory-layer li a {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0 0.08em;
    margin-inline-start: -0.08em;
    color: inherit;
    font-size: var(--directory-type);
    letter-spacing: -0.035em;
    line-height: var(--directory-type);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color 120ms ease-out;
  }
  .directory-layer li a:hover { background: var(--layer-color); color: #1e1e1e; }
  .directory-layer li a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

  @media (max-width: 1100px) {
    .landing { --landing-unit: min(calc(var(--unit, 20px) * var(--sf, 1)), calc(100vw / 39)); }
    .landing-directory { --directory-type: calc(4 * var(--landing-unit)); }
  }
  @media (max-width: 680px) {
    .landing { --landing-unit: min(calc(var(--unit, 20px) * var(--sf, 1)), calc(100vw / 21)); }
    .landing-layers { margin-inline-start: var(--landing-unit); }
    .landing-directory { --directory-type: calc(3 * var(--landing-unit)); margin-inline: var(--landing-unit); }
    .directory-layer { grid-template-columns: minmax(0, 1fr); }
    .directory-layer-head { position: static; }
  }
  :global(html.mobile) .landing { --landing-unit: min(calc(var(--unit, 20px) * var(--sf, 1)), calc(100vw / 21)); }
  :global(html.mobile) .landing-layers { margin-inline-start: var(--landing-unit); }
  :global(html.mobile) .landing-directory { --directory-type: calc(3 * var(--landing-unit)); margin-inline: var(--landing-unit); }
  :global(html.mobile) .directory-layer { grid-template-columns: minmax(0, 1fr); }
  :global(html.mobile) .directory-layer-head { position: static; }
  @media (prefers-reduced-motion: reduce) {
    .directory-layer li a { transition: none; }
  }
</style>
