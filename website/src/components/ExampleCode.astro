---
import '../vendor/aa/aa.css';
/** An example's source, with a copy button per block. Shared by component and layout examples. */
interface Props { html: string; script?: string; }
const { html, script } = Astro.props;
const blocks = [{ id: 'html', label: 'Copy HTML', text: html }, ...(script ? [{ id: 'script', label: 'Copy JavaScript', text: script }] : [])];
---
<div class="example-code-source" data-example-code>
  <ds-accordion summary="Code">
    <div slot="details">
      {blocks.map(block => (
        <div class="example-code-block">
          <ds-button control="slotted"><button type="button" data-copy={block.id}>{block.label}</button></ds-button>
          <div class="example-code-editor" data-code-editor aria-label={block.id === 'html' ? 'HTML source' : 'JavaScript source'}></div>
          <pre><code data-source={block.id}>{block.text}</code></pre>
        </div>
      ))}
    </div>
  </ds-accordion>
</div>
<script>
  import '../../../DS1/3-unit/ds-accordion';
  import { mountCodeEditors } from '../lib/example-code-editor';
  import { wireCodeCopy } from '../lib/example-controls';
  document.querySelectorAll<HTMLElement>('[data-example-code]').forEach(source => {
    wireCodeCopy(source);
    mountCodeEditors(source);
  });
</script>
<style is:global>
  .example-code-source { --example-code-unit: calc(20px * var(--sf, 1)); }
  .example-code-block { display: flex; flex-direction: column; align-items: flex-end; gap: calc(var(--example-code-unit) / 2); margin-block: calc(var(--example-code-unit) / 2); }
  .example-code-editor { align-self: stretch; min-width: 0; padding: var(--example-code-unit); background: var(--ds-fill); border-radius: calc(4px * var(--sf, 1)); --aa-code-paper: transparent; --aa-line: var(--example-code-unit); }
  .example-code-editor:empty { display: none; }
  .example-code-editor .aa-block[data-kind="code"] { padding: 0; white-space: pre; overflow-x: auto; -webkit-user-modify: read-only; }
  .example-code-block pre[hidden] { display: none; }
  .example-code-block pre { background: var(--ds-fill); align-self: stretch; margin: 0; padding: var(--example-code-unit); overflow-x: auto; border-radius: 4px; font-size: 13px; line-height: var(--example-code-unit); }
</style>
