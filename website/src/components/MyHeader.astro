---
// MyHeader component - custom header for docs
import Search from '@astrojs/starlight/components/Search.astro';
interface Props { landing?: boolean; }
const { landing = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--home': landing }]}>
  <!-- Mobile Menu Button -->
  {!landing && <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle navigation menu">
    <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <svg class="close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>}

  <!-- Left: Logo -->
  <div class="header-logo">
    <a href="/" class="logo-link">
      <span class="logo-text">Design system 1</span>
    </a>
  </div>

  {!landing && <div class="header-divider"></div>}

  <!-- Center: Search -->
  {!landing && <div class="header-search">
    <Search class="custom-search" />
  </div>}

  <!-- Right: Actions -->
  <div class="header-actions">
    {landing && <a class="header-docs" href="/getting-started/installation/">Documentation</a>}
    <a class="header-docs" href="/components/">Components</a>
    <a class="header-docs" href="/email/">Email design</a>
    <a class="header-docs" href="/icons/#builder">Icon builder</a>
    <a class="header-classless" href="/classless/editor/">CLASSless</a>
    <!-- Language Toggle using Design system 1 cycle component -->
    <div class="action-item">
      <ds-cycle type="language" variant="secondary"></ds-cycle>
    </div>

    <!-- Theme Toggle using Design system 1 cycle component -->
    <div class="action-item">
      <ds-cycle type="theme" variant="secondary"></ds-cycle>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--ds1-docs-header-bg);
    /* The hairline is a shadow, so the header stays three squares. */
    box-shadow: inset 0 -1px var(--ds1-docs-header-border);
    display: flex;
    align-items: center;
    height: 60px;
    position: relative;
  }

  /* Mobile menu button - hidden by default */
  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: 8px;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--ds1-docs-header-text);
    cursor: pointer;
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }

  .mobile-menu-btn:hover {
    background: var(--ds1-docs-search-bg);
  }

  .mobile-menu-btn .close-icon {
    display: none;
  }

  .mobile-menu-btn.active .hamburger-icon {
    display: none;
  }

  .mobile-menu-btn.active .close-icon {
    display: block;
  }

  /* Logo section */
  .header-logo {
    display: flex;
    align-items: center;
    height: 60px;
    width: 280px;
    padding: 0 40px;
    box-shadow: inset -1px 0 var(--ds1-docs-header-border);
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .logo-text {
    font-family: 'GT-America-Standard-Regular', sans-serif;
    font-size: 20px;
    line-height: 20px;
    color: var(--ds1-docs-header-text);
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  /* Header divider */
  .header-divider {
    width: 20px;
    height: 60px;
    box-shadow: inset -1px 0 var(--ds1-docs-header-border);
    flex-shrink: 0;
  }

  /* Search section */
  .header-search {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0 20px 0 40px;
    height: 60px;
    min-width: 0;
  }

  /* Actions section */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-right: 40px;
    flex-shrink: 0;
  }

  .action-item {
    display: flex;
    align-items: center;
  }

  .header-classless {
    color: var(--ds1-docs-header-text);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.28px;
    text-decoration: none;
    box-shadow: 0 1px var(--ds1-docs-accent-green);
  }

  .site-header--home { height: 80px; padding-inline: max(20px, calc((100% - 1360px) / 2)); gap: 20px; }
  .site-header--home .header-logo { width: auto; padding: 0; border: 0; }
  .site-header--home .header-actions { margin-left: auto; padding: 0; gap: 20px; }
  .header-docs { color: var(--ds1-docs-header-text); font-size: 14px; line-height: 20px; letter-spacing: -0.28px; text-decoration: none; }
  .header-docs:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .site-header.site-header--home { height: auto; min-height: 80px; padding: 20px; flex-wrap: wrap; gap: 20px; }
    .site-header--home .header-actions { flex-wrap: wrap; }
    .site-header--home .action-item { display: none; }
  }

  @media (max-width: 600px) {
    .header-classless { display: none; }
  }

  /* Style the search component */
  :global(.custom-search) {
    width: 100%;
    max-width: 300px;
  }

  :global(.custom-search button[data-open-modal]) {
    width: 100%;
    max-width: 300px;
    display: flex;
    align-items: center;
    gap: 4px;
    /* An item's row: one square, on the header's middle one. */
    height: 20px;
    padding: 0 4px;
    background: var(--ds1-docs-search-bg);
    border: none;
    border-radius: 4px;
    color: var(--ds1-docs-header-text-secondary);
    cursor: pointer;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.28px;
    font-family: 'GT-America-Standard-Regular', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    transition: color 0.2s ease;
  }

  :global(.custom-search button[data-open-modal]:hover) {
    color: var(--ds1-docs-header-text);
  }

  :global(.custom-search button[data-open-modal]:focus) {
    outline: none;
  }

  :global(.custom-search button[data-open-modal] kbd) {
    display: none;
  }

  :global(.custom-search button[data-open-modal] svg) {
    width: 16px;
    height: 16px;
  }

  /* Tablet Responsive Styles */
  @media (max-width: 1024px) {
    .header-logo {
      width: 240px;
      padding: 0 40px;
    }

    .header-actions {
      padding-right: 20px;
      gap: 20px;
    }
  }

  /* Mobile Responsive Styles */
  @media (max-width: 768px) {
    .site-header {
      height: 60px;
      padding: 0 8px;
      gap: 8px;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .header-logo {
      width: auto;
      padding: 0;
      box-shadow: none;
      flex: 0 0 auto;
    }

    .logo-text {
      font-size: 18px;
    }

    .header-divider {
      display: none;
    }

    .header-search {
      flex: 1;
      padding: 0 8px;
      min-width: 0;
    }

    :global(.custom-search) {
      width: 100%;
      max-width: none;
    }

    :global(.custom-search button[data-open-modal]) {
      width: 100%;
      max-width: none;
      padding: 0 10px;
    }

    .header-actions {
      padding-right: 8px;
      gap: 4px;
    }

    /* Hide language toggle on very small screens */
    @media (max-width: 480px) {
      .header-actions .action-item:first-child {
        display: none;
      }
    }
  }
</style>

<script is:inline>
  // Toggle button state when sidebar opens/closes
  document.addEventListener('DOMContentLoaded', function() {
    const menuButton = document.getElementById('mobile-menu-btn');
    const sidebar = document.getElementById('sidebar');

    // Create a MutationObserver to watch for class changes on sidebar
    if (sidebar && menuButton) {
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.attributeName === 'class') {
            if (sidebar.classList.contains('open')) {
              menuButton.classList.add('active');
            } else {
              menuButton.classList.remove('active');
            }
          }
        });
      });

      observer.observe(sidebar, { attributes: true });
    }
  });
</script>
