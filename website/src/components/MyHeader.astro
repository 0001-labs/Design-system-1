---
import '../../../DS1/1-root/one.css';
import { siteNavigation, isNavigationCurrent } from '../../../shared/site-navigation';
import '../../../shared/site-navigation.css';
interface Props { landing?: boolean; }
const { landing = false } = Astro.props;
---

<header class="site-navigation">
  <a class="site-brand" href="/">Design system 1</a>
  <nav class="site-links" aria-label="Main navigation">
    {!landing && <button id="mobile-menu-btn" class="site-browse" type="button" aria-controls="sidebar" aria-expanded="false">Browse docs</button>}
    {siteNavigation.map((item) => (
      <a href={item.href} aria-current={isNavigationCurrent(item.href, Astro.url.pathname) ? 'page' : undefined}>{item.label}</a>
    ))}
    <div class="site-tools" role="group" aria-label="Preferences">
      <ds-cycle type="language" variant="secondary"></ds-cycle>
      <ds-cycle type="theme" variant="secondary"></ds-cycle>
    </div>
  </nav>
  <a class="site-account" href="/app/signin">Sign in</a>
</header>

<script>
  import '../../../DS1/2-core/ds-cycle';
  import '../../../DS1/0-face/device';
</script>
