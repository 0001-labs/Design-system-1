---
import '../../../DS1/1-root/one.css';
import { version } from '../../../package.json';
import '../../../shared/site-navigation.css';
---

<header class="ds-header ds-header--app site-navigation docs-header docs-header--with-sidebar">
  <nav class="system-breadcrumb" aria-label="System breadcrumb"><a class="site-brand" href="/"><code class="internal-identity">DS1 </code>Design system 1<span class="internal-identity"> {version}</span></a><span id="private-component-context" hidden>App</span></nav>
  <button id="mobile-menu-btn" class="site-brand docs-brand-menu" type="button" aria-label="Open documentation navigation" aria-controls="mobile-navigation-panel" aria-haspopup="dialog" aria-expanded="false"><ds-icon type="menu" aria-hidden="true"></ds-icon></button>
</header>
<iframe id="navigation-auth" title="Account status" hidden aria-hidden="true" tabindex="-1"></iframe>

<script>
  import '../lib/public-preferences';
  import { connectNavigationSession } from '../lib/navigation-session';
  import { connectCodeCopy } from '../lib/code-copy';
  connectCodeCopy();
  import '../../../DS1/0-face/device';
  const updateLayout = () => {
    const root = document.documentElement;
    const scale = Number.parseFloat(getComputedStyle(root).getPropertyValue('--sf')) || 1;
    root.toggleAttribute('data-docs-compact', root.clientWidth / scale <= 768);
  };
  updateLayout();
  window.addEventListener('scaling-changed', updateLayout);
  window.addEventListener('resize', updateLayout);

  const frame = document.querySelector<HTMLIFrameElement>('#navigation-auth')!;
  const navigation = connectNavigationSession(frame, detail => {
    const authenticated = detail.authenticated === true;
    document.documentElement.toggleAttribute('data-signed-in', authenticated);
    document.documentElement.toggleAttribute('data-ds-owner', authenticated && detail.owner === true);
    window.dispatchEvent(new CustomEvent('ds1-navigation-auth', { detail: { ...detail, authenticated } }));
  });
  window.addEventListener('message', (event) => {
    if (event.origin !== location.origin || event.source !== frame?.contentWindow) return;
    if (event.data?.type === 'ds1:library-created' && typeof event.data.id === 'string') {
      location.href = `/libraries/workspace/?${new URLSearchParams({ library: event.data.id, view: 'overview' })}`;
      return;
    }
    if (event.data?.type !== 'ds1:navigation-auth') return;
    navigation.receive(event.data);
  });
</script>

<style>
  .internal-identity { display: none; font-size: var(--ds-type-size-default); color: inherit; }
  code.internal-identity { font-family: var(--ds-typeface-mono); }
  :global(html[data-ds-owner]) .internal-identity { display: inline; }
  .docs-header { display: flex; align-items: center; }
  .docs-header .system-breadcrumb .site-brand { text-decoration: none; }
  #private-component-context { color: var(--ds-text-color-muted); }
  #private-component-context[hidden] { display: none; }
  .docs-header .docs-brand-menu { display: none; padding: 0; justify-content: flex-start; }
  @media (max-width: 768px) {
    .docs-header--with-sidebar .system-breadcrumb { flex: 1; min-width: 0; }
    .docs-header .docs-brand-menu { display: inline-flex; width: var(--site-unit); overflow: hidden; font-size: 0; }

  }
  :global(html[data-docs-compact]) .docs-header--with-sidebar .system-breadcrumb { flex: 1; min-width: 0; }
  :global(html[data-docs-compact]) .docs-header .docs-brand-menu { display: inline-flex; width: var(--site-unit); overflow: hidden; font-size: 0; }
</style>
