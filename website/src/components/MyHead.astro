---
// Import the default Starlight Head component
import Default from '@astrojs/starlight/components/Head.astro';
---

<!-- Include default Starlight head elements -->
<Default><slot /></Default>
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<script is:inline src="/google-analytics.js" defer />

<script>
  import '../../../DS1/0-face/grid';
</script>

<!-- Load Design system 1 CSS from CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/design-system-1@0.3.0-alpha.9/DS1/1-root/one.css" />

<!-- Pre-load translations and then load Design system 1 bundle -->
<script is:inline>
  // MUST load translations before Design system 1 bundle initializes
  (async function() {
    try {
      const response = await fetch('/translations.json');
      const translations = await response.json();
      
      // Make translations available to Design system 1 BEFORE loading bundle
      window.DS_ONE_TRANSLATIONS = translations;

      const availableLanguages = Object.keys(translations);
      console.log('[App] Translations pre-loaded:', availableLanguages.length, 'languages');

      // NOW load Design system 1 bundle after translations are ready
      const script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://cdn.jsdelivr.net/npm/design-system-1@0.3.0-alpha.9/dist/design-system-1.bundle.min.js';
      script.addEventListener('load', () => {
        window.dispatchEvent(new CustomEvent('translations-ready', {
          detail: { languages: availableLanguages }
        }));
      }, { once: true });
      script.addEventListener('error', () => {
        window.dispatchEvent(new CustomEvent('translations-ready', {
          detail: { languages: availableLanguages }
        }));
      }, { once: true });
      document.head.appendChild(script);
    } catch (error) {
      console.error('[App] Failed to pre-load translations:', error);
      
      // Load Design system 1 anyway even if translations fail
      const script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://cdn.jsdelivr.net/npm/design-system-1@alpha/dist/design-system-1.bundle.js';
      script.addEventListener('load', () => {
        window.dispatchEvent(new CustomEvent('translations-ready', {
          detail: { languages: [] }
        }));
      }, { once: true });
      document.head.appendChild(script);
    }
  })();
</script>

<style>
  /* Ensure Design system 1 components work well with Starlight */
  :root {
    /* Design system 1 accent color matches our theme */
    --accent-color: #72FF3D;
  }
</style>
