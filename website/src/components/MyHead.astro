---
// Import the default Starlight Head component
import Default from '@astrojs/starlight/components/Head.astro';
import PublicPreferences from './PublicPreferences.astro';
import FeedbackLoop from './FeedbackLoop.astro';
// The Languages page and the language picker show Japanese and Chinese. cjk.css is linked
// as its own file, so its @import rules stay first in their sheet.
import cjkStylesheet from '../../../DS1/1-root/cjk.css?url';
---

<!-- Include default Starlight head elements -->
<Default><slot /></Default>
<PublicPreferences />
<link rel="stylesheet" href={cjkStylesheet} />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<script is:inline src="/google-analytics.js" defer />
<FeedbackLoop />

<script>
  import '../../../DS1/1-root/one.css';
  import '../../../DS1/index';
</script>

<style>
  /* Ensure Design system 1 components work well with Starlight */
  :root {
    /* Design system 1 accent color matches our theme */
    --accent-color: var(--apple-green);
  }
</style>
