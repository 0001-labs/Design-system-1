---
interface Props {
  mode: 'editor' | 'libraries';
}

const { mode } = Astro.props;
const appPath = mode === 'editor' ? '/app/playground' : '/app/libraries';
---

<section class="classless-workspace" aria-labelledby="classless-title" data-pagefind-body>
  <div class="classless-heading">
    <div>
      <h1 id="classless-title">Design system 1</h1>
      <p>Native HTML. Your design. One stylesheet.</p>
    </div>
    <a href={`${appPath}?standalone=1`} target="_blank" rel="noopener">Open full screen</a>
  </div>
  <nav class="classless-tabs" aria-label="Design system 1">
    <a href="/start-here/overview/">Overview</a>
    <a data-requires-signin href="/classless/libraries/" aria-current="page">My libraries</a>
    <span>{mode === 'editor' ? 'Playground · changes are temporary' : 'Saved stylesheets'}</span>
  </nav>
  <iframe
    id="classless-app"
    src={`${appPath}?embed=docs`}
    title={mode === 'editor' ? 'Design system 1 editor' : 'My libraries'}
  ></iframe>
</section>

<script>
  import { libraryHeading, libraryHref, libraryWorkspaceHref, readLibraryNavigation, type LibraryNavigation } from '../../../shared/library-navigation';
  const frame = document.querySelector<HTMLIFrameElement>('#classless-app');
  if (frame) {
    // The docs are static: read the current library from the browser URL, not build-time Astro.url.
    const query = new URLSearchParams(location.search);
    const libraryId = query.get('library');
    if (libraryId) {
      const appQuery = new URLSearchParams({ embed: 'docs' });
      if (query.has('component')) appQuery.set('component', query.get('component')!);
      frame.src = `/app/l/${encodeURIComponent(libraryId)}?${appQuery}`;
    }
    const sendTheme = () => {
      const root = document.documentElement;
      const theme = root.classList.contains('dark-theme') ? 'dark'
        : root.classList.contains('light-theme') ? 'light'
        : root.dataset.theme === 'light' ? 'light' : 'dark';
      frame.contentWindow?.postMessage({ type: 'ds1:docs-theme', theme }, window.location.origin);
    };
    const requestLibrary = () => frame.contentWindow?.postMessage({ type: 'ds1:library-navigation-request' }, location.origin);
    frame.addEventListener('load', () => { sendTheme(); requestLibrary(); });
    requestLibrary();
    window.addEventListener('theme-changed', sendTheme);
    const renderLibrary = (library: LibraryNavigation | null) => {
      document.documentElement.toggleAttribute('data-library-workspace', library !== null);
      window.dispatchEvent(new CustomEvent('ds1-library-navigation', { detail: { library } }));
      const heading = document.querySelector('#classless-title');
      if (heading) heading.textContent = library ? libraryHeading(library) : 'Design system 1';
      const fullScreen = document.querySelector<HTMLAnchorElement>('.classless-heading > a');
      if (fullScreen) fullScreen.href = library ? `${libraryHref(library)}&standalone=1` : '/app/libraries?standalone=1';
      frame.title = library ? libraryHeading(library) : 'My libraries';
      if (library) history.replaceState({}, '', libraryWorkspaceHref(library));
    };
    window.addEventListener('ds1-navigation-auth', event => {
      if ((event as CustomEvent).detail.authenticated) requestLibrary();
      else renderLibrary(null);
    });
    window.addEventListener('message', (event) => {
      if (event.origin === window.location.origin && event.source === frame.contentWindow
        && event.data?.type === 'ds1:docs-ready') { sendTheme(); requestLibrary(); }
      if (event.origin !== location.origin || event.source !== frame.contentWindow || event.data?.type !== 'ds1:library-navigation') return;
      const library = document.documentElement.hasAttribute('data-signed-in') ? readLibraryNavigation(event.data.library) : null;
      renderLibrary(library);
      if (event.data.libraryId === null && location.search) history.replaceState({}, '', location.pathname);
    });
    new MutationObserver(sendTheme).observe(document.documentElement, {
      attributes: true, attributeFilter: ['class', 'data-theme'],
    });
  }
</script>

<style>
  .classless-workspace {
    height: 100%;
    min-width: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    background: var(--ds1-docs-content-bg);
  }

  .classless-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 40px 24px;
  }

  h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  p {
    margin: 8px 0 0;
    color: var(--ds1-docs-header-text-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  a {
    color: var(--ds1-docs-header-text);
    font-size: 13px;
    white-space: nowrap;
    text-decoration: none;
  }

  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 4px; }

  .classless-tabs {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-inline: 40px;
    border-bottom: 1px solid var(--ds1-docs-divider);
    background: var(--ds1-docs-sidebar-bg);
  }

  .classless-tabs a {
    padding-block: 14px;
    border-bottom: 2px solid transparent;
  }

  .classless-tabs a[aria-current='page'] {
    border-color: var(--ds1-docs-accent-green);
  }

  .classless-tabs span {
    margin-left: auto;
    color: var(--ds1-docs-header-text-secondary);
    font-size: 12px;
  }

  iframe { display: block; width: 100%; height: 100%; min-height: 0; border: 0; }

  @media (max-width: 1100px) {
    .classless-tabs span { display: none; }
  }

  @media (max-width: 768px) {
    .classless-heading { padding: 20px; gap: 12px; align-items: flex-start; }
    h1 { font-size: 22px; }
    .classless-heading > a { font-size: 11px; }
    .classless-tabs { padding-inline: 20px; gap: 20px; }
  }
</style>

<style is:global>
  html[data-library-workspace] .classless-workspace { grid-template-rows: minmax(0, 1fr); }
  html[data-library-workspace] :is(.classless-heading, .classless-tabs, .right-sidebar-container) { display: none; }
</style>
