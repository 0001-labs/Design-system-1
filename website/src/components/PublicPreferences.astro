---
import translations from '../../public/translations.json';
import themeBootstrap from '../../../DS1/0-face/theme-bootstrap.js?raw';
const languages = [...new Set(['en', ...Object.keys(translations)])];
---
<script is:inline define:vars={{ languages }}>
  window.DS_ONE_I18N = { autoLoad: false, persist: false, languages };
  // The docs follow the reader's system and keep the documentation theme's own paper.
  window.DS_ONE_PREFERENCES = { ...window.DS_ONE_PREFERENCES, themeMode: 'system', themePaper: false };
</script>
<script is:inline set:html={themeBootstrap}></script>
