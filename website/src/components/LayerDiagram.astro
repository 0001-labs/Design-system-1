---
// The four layers drawn as a diagram of item cells: every box one cell,
// four squares by one (80 by 20), stacked edge to edge under its group's name and what it is, groups
// two squares apart with an arrow from each to the next. Page is the last
// layer, so its name has no arrow.
import { LAYERS } from '../lib/component-directory';

// What a box says under the pointer: the element as it is written in HTML.
const inCode = (tag: string) => (tag.startsWith('ds-') ? `<${tag}>` : tag);
---

<div class="layer-diagram" role="group" aria-label="The four layers of Design system 1, each built from the one before">
  {LAYERS.map((layer, index) => (
    <div class="layer-group" data-color={layer.color}>
      <p class="layer-name">
        <a class="ds-link" href={`/${layer.number}-${layer.name.toLowerCase()}/overview/`}>{layer.number} {layer.name}</a>
        {index < LAYERS.length - 1 && (
          <span class="layer-arrow" aria-hidden="true">
            <svg class="layer-arrow-head" viewBox="-0.17 -0.12 0.17 0.24"><polyline points="-0.164,-0.115 0,0 -0.164,0.115" /></svg>
          </span>
        )}
      </p>
      <p class="layer-summary">{layer.summary}</p>
      <ul>
        {layer.entries.map((entry) => (
          <li>
            <a href={entry.href}>
              <span class="layer-text">
                <span class="layer-word">{entry.name}</span>
                {entry.tag && <span class="layer-tag">{inCode(entry.tag)}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

</div>

<style>
  .layer-diagram {
    --diagram-unit: var(--landing-unit);
    --diagram-ink: var(--ds1-docs-header-text);
    display: grid;
    grid-template-columns: repeat(4, calc(4 * var(--diagram-unit)));
    column-gap: calc(2 * var(--diagram-unit));
    row-gap: calc(2 * var(--diagram-unit));
    align-items: start;
    color: var(--diagram-ink);
    font-family: var(--typeface-regular);
    font-size: var(--landing-type);
    line-height: var(--diagram-unit);
  }
  .layer-group { position: relative; --summary-rows: 3; --box-radius: calc(0.2 * var(--diagram-unit)); --box-fill: light-dark(#e6e6e6, #fff); }
  .layer-group[data-color='light-green'] { --box-fill: #99ff73; }
  .layer-group[data-color='light-blue'] { --box-fill: #ccccff; }
  .layer-group[data-color='pink'] { --box-fill: #f5aad1; }
  .layer-group[data-color='yellow'] { --box-fill: #eaff00; }
  .layer-group[data-color='grey'] { --box-fill: light-dark(#e6e6e6, #bdbdbd); }

  .layer-name { margin: 0; font-family: var(--typeface-medium); }
  /* The name is a link in running text, as `.ds-link` in controls.css draws
     it (the site does not load that sheet): the text's ink, a hairline
     underline 2px below the letters that turns to the full ink under the
     pointer, and the muted ink once visited. */
  .layer-name .ds-link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: calc(2px * var(--sf, 1));
    transition: none;
  }
  .layer-name .ds-link:visited { color: var(--ds1-docs-header-text-secondary); }
  .layer-name .ds-link:hover { color: inherit; text-decoration-color: currentColor; }
  .layer-name .ds-link:visited:hover { color: var(--ds1-docs-header-text-secondary); }
  .layer-name .ds-link:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }
  .layer-group ul { margin: 0; padding: 0; list-style: none; }
  .layer-group li { margin: 0; }
  /* A box is an item cell, four squares by one (80 by 20). A stack wears
     the item's radius on its outer corners only: a shared corner is square,
     and a coloured box's edge is its own fill, so none shows between two. */
  .layer-group li a {
    display: block;
    height: var(--diagram-unit);
    padding: 0 calc(0.2 * var(--diagram-unit));
    background: var(--box-fill);
    color: #2a2a2a;
    line-height: var(--diagram-unit);
    white-space: nowrap;
    text-decoration: none;
  }
  .layer-group li:first-child a { border-start-start-radius: var(--box-radius); border-start-end-radius: var(--box-radius); }
  .layer-group li:last-child a { border-end-start-radius: var(--box-radius); border-end-end-radius: var(--box-radius); }

  @supports (corner-shape: squircle) {
    .layer-group li a { corner-shape: squircle; }
  }
  /* A name too long for its box fades at the far edge rather than being cut. */
  .layer-text {
    display: block;
    min-width: 0;
    flex: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 0.6 * var(--diagram-unit)), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 0.6 * var(--diagram-unit)), transparent);
  }
  .layer-tag { display: none; }
  /* Under the pointer a box says its element, and widens to say all of it. */
  .layer-group li { position: relative; }
  .layer-group li a:is(:hover, :focus-visible) {
    position: relative;
    z-index: 2;
    width: max-content;
    min-width: 100%;
    background: var(--diagram-ink);
    color: var(--ds1-docs-content-bg);
    text-decoration: none;
  }
  .layer-group li a:is(:hover, :focus-visible) .layer-text { -webkit-mask-image: none; mask-image: none; overflow: visible; }
  .layer-group li a:is(:hover, :focus-visible) .layer-word:not(:only-child) { display: none; }
  .layer-group li a:is(:hover, :focus-visible) .layer-tag { display: inline; }

  /* The arrow leaves the first box's edge and ends on the next group's. */
  /* A layer leads to the next along the names' row: a line from a quarter
     square after its name to a fifth of a square before the next, ending in
     an arrowhead of two strokes a fifth of a square long at 35 degrees. */
  .layer-name { display: flex; align-items: center; width: calc(6 * var(--diagram-unit)); }
  .layer-arrow {
    position: relative;
    flex: 1;
    height: 1px;
    margin-inline: calc(0.25 * var(--diagram-unit)) calc(0.2 * var(--diagram-unit));
    background: currentColor;
  }
  .layer-arrow-head {
    position: absolute;
    right: 0;
    top: 50%;
    width: calc(0.17 * var(--diagram-unit));
    height: calc(0.24 * var(--diagram-unit));
    translate: 0 -50%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .layer-arrow-head polyline { vector-effect: non-scaling-stroke; }
  /* Every explanation is written to fit three rows and keeps all three, so the boxes start on one line. */
  .layer-summary {
    /* Wider than a box: it runs on into the two squares before the next group. */
    width: calc(5.5 * var(--diagram-unit));
    min-height: calc(var(--summary-rows) * var(--diagram-unit));
    margin: 0 0 var(--diagram-unit);
    color: var(--ds1-docs-header-text-secondary);
  }

  @media (max-width: 680px) {
    .layer-diagram { grid-template-columns: repeat(2, calc(4 * var(--diagram-unit))); row-gap: calc(2 * var(--diagram-unit)); }
    .layer-group:nth-child(2n) .layer-arrow { display: none; }
  }
  :global(html.mobile) .layer-diagram { grid-template-columns: repeat(2, calc(4 * var(--diagram-unit))); row-gap: calc(2 * var(--diagram-unit)); }
  :global(html.mobile) .layer-group:nth-child(2n) .layer-arrow { display: none; }
</style>
