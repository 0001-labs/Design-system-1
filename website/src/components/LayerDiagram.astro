---
// The four layers drawn the way Ezo draws a diagram: every box an item cell,
// four squares by one (80 by 20), stacked edge to edge under its group's name and what it is, groups
// two squares apart with an arrow from each to the next.
import { ICONS, ICON_SUMMARY, LAYERS } from '../lib/component-directory';

// The icons fill columns of boxes side by side, five across and two on a
// phone. Only the block's outer corners are round, so each layout names the
// boxes that stand on one.
const corners = (columns: number) => {
  const rows = Math.ceil(ICONS.length / columns);
  const last = ICONS.length - 1;
  const lastTop = (columns - 1) * rows;
  const names = new Map<number, string[]>();
  const add = (index: number, corner: string) => names.set(index, [...(names.get(index) ?? []), corner]);
  add(0, 'tl');
  add(rows - 1, 'bl');
  add(lastTop, 'tr');
  add(last, 'br');
  // A short last column leaves the foot of the one before it open.
  if (last < columns * rows - 1) add(lastTop - 1, 'br');
  return { rows, names };
};
const wide = corners(5);
const narrow = corners(2);
const cornerClasses = (index: number) => [
  ...(wide.names.get(index) ?? []).map((corner) => `wide-${corner}`),
  ...(narrow.names.get(index) ?? []).map((corner) => `narrow-${corner}`),
];
---

<div class="layer-diagram" role="group" aria-label="The four layers of Design system 1, each built from the one before, and its icons">
  {LAYERS.map((layer, index) => (
    <div class="layer-group" data-color={layer.color}>
      <p class="layer-name">{layer.number} {layer.name}</p>
      <p class="layer-summary">{layer.summary}</p>
      <ul>
        {layer.entries.map((entry) => (
          <li><a href={entry.href}>{entry.name}</a></li>
        ))}
      </ul>
      {index < LAYERS.length - 1 && (
        <svg class="layer-arrow" viewBox="0 0 2 1" aria-hidden="true">
          <polyline points="0,0.5 2,0.5" vector-effect="non-scaling-stroke" />
          <polyline points="1.836,0.385 2,0.5 1.836,0.615" vector-effect="non-scaling-stroke" />
        </svg>
      )}
    </div>
  ))}
  <div class="layer-group layer-group--icons" data-color="yellow" style={`--wide-rows: ${wide.rows}; --narrow-rows: ${narrow.rows}`}>
    <p class="layer-name">x Icon</p>
    <p class="layer-summary">{ICON_SUMMARY}</p>
    <ul>
      {ICONS.map((icon, index) => (
        <li class:list={cornerClasses(index)}>
          <a href="/icons"><span class="layer-icon" aria-hidden="true" set:html={icon.svg} />{icon.name}</a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .layer-diagram {
    --diagram-unit: var(--landing-unit);
    --diagram-ink: var(--ds1-docs-header-text);
    display: grid;
    grid-template-columns: repeat(4, calc(4 * var(--diagram-unit)));
    column-gap: calc(2 * var(--diagram-unit));
    row-gap: calc(2 * var(--diagram-unit));
    align-items: start;
    color: var(--diagram-ink);
    font-family: var(--typeface-regular);
    font-size: var(--landing-type);
    line-height: var(--diagram-unit);
  }
  .layer-group { position: relative; --summary-rows: 3; --box-radius: calc(0.2 * var(--diagram-unit)); --box-fill: light-dark(#e6e6e6, #fff); }
  .layer-group[data-color='light-green'] { --box-fill: #99ff73; }
  .layer-group[data-color='light-blue'] { --box-fill: #ccccff; }
  .layer-group[data-color='pink'] { --box-fill: #f5aad1; }
  .layer-group[data-color='yellow'] { --box-fill: #eaff00; }

  .layer-name { margin: 0; font-family: var(--typeface-medium); }
  .layer-group ul { margin: 0; padding: 0; list-style: none; }
  .layer-group li { margin: 0; }
  /* A box is Ezo's item cell, four squares by one (80 by 20). A stack wears
     the item's radius on its outer corners only: a shared corner is square,
     and a coloured box's edge is its own fill, so none shows between two. */
  .layer-group li a {
    display: block;
    height: var(--diagram-unit);
    padding: 0 calc(0.2 * var(--diagram-unit));
    overflow: hidden;
    background: var(--box-fill);
    color: #2a2a2a;
    line-height: var(--diagram-unit);
    white-space: nowrap;
    text-decoration: none;
  }
  .layer-group:not(.layer-group--icons) li:first-child a { border-start-start-radius: var(--box-radius); border-start-end-radius: var(--box-radius); }
  .layer-group:not(.layer-group--icons) li:last-child a { border-end-start-radius: var(--box-radius); border-end-end-radius: var(--box-radius); }

  /* The icons stand under the layers, their boxes in columns edge to edge. */
  .layer-group--icons { grid-column: 1 / -1; --summary-rows: 1; --icon-rows: var(--wide-rows); }
  .layer-group--icons .layer-summary { width: auto; }
  .layer-group--icons ul {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(4 * var(--diagram-unit));
    grid-template-rows: repeat(var(--icon-rows), var(--diagram-unit));
  }
  .layer-group--icons li a { display: flex; align-items: center; gap: calc(0.2 * var(--diagram-unit)); border-radius: 0; }
  .layer-icon { display: block; flex: none; width: calc(0.8 * var(--diagram-unit)); height: calc(0.8 * var(--diagram-unit)); }
  .layer-icon :global(svg) { display: block; width: 100%; height: 100%; }
  .layer-group--icons li.wide-tl a { border-start-start-radius: var(--box-radius); }
  .layer-group--icons li.wide-tr a { border-start-end-radius: var(--box-radius); }
  .layer-group--icons li.wide-bl a { border-end-start-radius: var(--box-radius); }
  .layer-group--icons li.wide-br a { border-end-end-radius: var(--box-radius); }

  @supports (corner-shape: squircle) {
    .layer-group li a { corner-shape: squircle; }
  }
  .layer-group li a:hover { background: var(--diagram-ink); color: var(--ds1-docs-content-bg); text-decoration: none; }

  /* The arrow leaves the first box's edge and ends on the next group's. */
  .layer-arrow {
    position: absolute;
    top: calc((2 + var(--summary-rows)) * var(--diagram-unit));
    left: 100%;
    width: calc(2 * var(--diagram-unit));
    height: var(--diagram-unit);
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
    stroke-linejoin: miter;
  }
  /* Every explanation is written to fit three rows and keeps all three, so the boxes start on one line. */
  .layer-summary {
    /* Wider than a box: it runs on into the two squares before the next group. */
    width: calc(5.5 * var(--diagram-unit));
    min-height: calc(var(--summary-rows) * var(--diagram-unit));
    margin: 0 0 var(--diagram-unit);
    color: var(--ds1-docs-header-text-secondary);
  }

  @media (max-width: 680px) {
    .layer-diagram { grid-template-columns: repeat(2, calc(4 * var(--diagram-unit))); row-gap: calc(2 * var(--diagram-unit)); }
    .layer-group:nth-child(2n) .layer-arrow { display: none; }
    .layer-group--icons { --icon-rows: var(--narrow-rows); }
    .layer-group--icons li a { border-radius: 0; }
    .layer-group--icons li.narrow-tl a { border-start-start-radius: var(--box-radius); }
    .layer-group--icons li.narrow-tr a { border-start-end-radius: var(--box-radius); }
    .layer-group--icons li.narrow-bl a { border-end-start-radius: var(--box-radius); }
    .layer-group--icons li.narrow-br a { border-end-end-radius: var(--box-radius); }
  }
  :global(html.mobile) .layer-diagram { grid-template-columns: repeat(2, calc(4 * var(--diagram-unit))); row-gap: calc(2 * var(--diagram-unit)); }
  :global(html.mobile) .layer-group:nth-child(2n) .layer-arrow { display: none; }
  :global(html.mobile) .layer-group--icons { --icon-rows: var(--narrow-rows); }
  :global(html.mobile) .layer-group--icons li a { border-radius: 0; }
  :global(html.mobile) .layer-group--icons li.narrow-tl a { border-start-start-radius: var(--box-radius); }
  :global(html.mobile) .layer-group--icons li.narrow-tr a { border-start-end-radius: var(--box-radius); }
  :global(html.mobile) .layer-group--icons li.narrow-bl a { border-end-start-radius: var(--box-radius); }
  :global(html.mobile) .layer-group--icons li.narrow-br a { border-end-end-radius: var(--box-radius); }
</style>
