---
import { scopedSvg } from '../lib/icons/svgView';
import icons from '../lib/icons/interface-catalog.json';
const star = icons.find(icon => icon.key === 'star') ?? icons[0];
---
<section id="interface-panel" role="tabpanel" aria-labelledby="interface-tab">
  <div class="vector-workspace">
    <section class="vector-library" aria-label="SVG icon collection">
      <div class="vector-library-heading"><h2>The collection</h2><span id="vector-count">{icons.length} icons</span></div>
      <label class="vector-search"><span aria-hidden="true">⌕</span><input id="vector-search" type="search" placeholder="Find an icon…" aria-label="Find an icon" /></label>
      <div class="vector-tiles" id="vector-tiles">
        {icons.map(icon => <button data-vector-key={icon.key} aria-pressed={icon.key === star.key} title={icon.name}><span class="vector-thumbnail" set:html={scopedSvg(icon.svg,'tile-'+icon.key)} /><span>{icon.name}</span></button>)}
      </div>
      <p id="vector-empty" hidden>No icons match that name.</p>
    </section>
    <section class="vector-inspector" aria-label="SVG outline inspector">
      <div class="vector-title-row"><h2 id="vector-name">{star.name}</h2><a id="vector-source" href="https://www.figma.com/design/XAnoaRoq9LxVAHUZgtdO0r/ds1?node-id=115-171" target="_blank" rel="noreferrer">Source ↗</a></div>
      <div class="vector-view-toolbar"><div class="segmented" aria-label="SVG view"><button data-vector-view="original" aria-pressed="false">Original</button><button data-vector-view="outline" aria-pressed="true">Outlines</button><button data-vector-view="both" aria-pressed="false">Both</button></div></div>
      <div class="vector-paper"><div class="vector-stage" id="vector-stage" data-view="outline"><div id="vector-artwork" class="vector-artwork" set:html={scopedSvg(star.svg,'focus-original')} /><div id="vector-outlines" class="vector-artwork"></div><svg id="vector-grid-lines" viewBox="0 0 16 16" aria-hidden="true">{Array.from({length:17},(_,n)=><path d={`M${n} 0V16M0 ${n}H16`} class={n%4===0?'major':'minor'} />)}</svg></div></div>
      <div class="vector-downloads"><button id="vector-copy" class="primary">Copy SVG</button><a id="vector-download" href={star.url} download={`${star.name.toLowerCase()}.svg`}>Download SVG ↓</a><button id="vector-download-outlines">Outlines ↓</button></div>
      <p id="vector-notice" class="vector-notice" role="status" aria-live="polite"></p>
    </section>
  </div>
</section>
<script>import '../lib/icons/interface';</script>
