---
import PaperMaterial from './PaperMaterial.astro';
// The front of the Design system 1 packaging: squares halving in size row by
// row, the product's name standing down the red column.
const C = {
  blue: '#594dff', red: '#c50124', green: '#f2ffcf', apple: '#99ff73', stealth: '#554455',
  soft: '#cdd3fe', sand: '#dbc88f', ochre: '#b69e55', blood: '#de0331', slate: '#1e1e1e',
  egg: '#f9f6ef', sky: '#69d8fb', metal: '#026d5b', chartreuse: '#ccff4d', drip: '#fde70c',
  tuned: '#ff5f5f', grey: '#797979', pink: '#f5aad1', zenith: '#ccccff', every: '#979441',
  white: '#ffffff', yellow: '#eaff00', black: '#000000',
} as const;
type Color = keyof typeof C;

interface Props {
  /** Drawn inside the Overview's column, as wide as it, with no buttons: the reader is already in the docs. */
  embedded?: boolean;
}
const { embedded = false } = Astro.props;

// The squares halve row by row, so each row has twice as many: 2, 4, 8 and 16
// across, sixteen squares of the 20px grid wide. Halving falls one small row
// short of a square, so the last row is drawn twice.
const rows: { size: number; colors: Color[] }[] = [
  { size: 160, colors: ['blue', 'red'] },
  { size: 80, colors: ['green', 'stealth', 'red', 'blood'] },
  { size: 40, colors: ['apple', 'soft', 'sand', 'ochre', 'sky', 'blood', 'metal', 'green'] },
  { size: 20, colors: ['egg', 'chartreuse', 'drip', 'tuned', 'grey', 'pink', 'metal', 'blood', 'zenith', 'egg', 'blue', 'slate', 'blood', 'pink', 'sky', 'white'] },
  { size: 20, colors: ['tuned', 'every', 'sky', 'stealth', 'drip', 'metal', 'white', 'yellow', 'blue', 'every', 'black', 'blood', 'metal', 'apple', 'zenith', 'egg'] },
];

let y = 0;
const tiles = rows.flatMap((row) => {
  const top = y;
  y += row.size;
  return row.colors.map((color, index) => ({ x: index * row.size, y: top, size: row.size, fill: C[color] }));
});
---

<div class:list={{ 'landing-hero-frame': embedded }}>
<section class:list={['landing-hero', { 'landing-hero--embedded': embedded }]} aria-label={embedded ? 'Design system 1' : undefined} aria-labelledby={embedded ? undefined : 'landing-title'}>
  <svg class="landing-hero-blocks" viewBox="0 0 320 320" preserveAspectRatio="xMinYMin slice" shape-rendering="crispEdges" aria-hidden="true">
    {tiles.map((tile) => <rect x={tile.x} y={tile.y} width={tile.size + 0.5} height={tile.size + 0.5} fill={tile.fill} />)}
  </svg>
  <PaperMaterial />
  {embedded
    ? <p class="landing-hero-title" aria-hidden="true">Design system 1</p>
    : <h1 id="landing-title" class="landing-hero-title">Design system 1</h1>}
  {!embedded && <div class="landing-hero-panel">
    <nav class="landing-hero-actions" aria-label="Get started">
      <a class="landing-hero-button landing-hero-button--primary" href="#learn-more">Learn more</a>
      <a class="landing-hero-button" href="/">Go to docs</a>
    </nav>
  </div>}
</section>
</div>

<style>
  .landing-hero {
    /* One unit of the artwork, which always covers the screen from its top left corner. */
    --hero-scale: max(100vw / 320, 100vh / 320);
    --hero-scale: max(100vw / 320, 100dvh / 320);
    --hero-title-column: 240;
    --hero-title-size: min(12.5vh, 45 * var(--hero-scale));
    --hero-title-size: min(12.5dvh, 45 * var(--hero-scale));
    --hero-edge: clamp(16px, 2.5vw, 40px);
    position: relative;
    height: calc(100vh - var(--site-header-height));
    height: calc(100dvh - var(--site-header-height));
    min-height: 480px;
    overflow: hidden;
    background: #594dff;
  }
  .landing-hero-blocks {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The name runs down the middle of a red column, as on the box. */
  .landing-hero-title {
    position: absolute;
    top: var(--hero-edge);
    left: calc(var(--hero-title-column) * var(--hero-scale));
    margin: 0;
    transform: translateX(-50%);
    writing-mode: vertical-rl;
    color: #fff;
    font-family: var(--typeface-regular);
    font-size: var(--hero-title-size);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  /* The one button stands centred at the cover's foot. */
  .landing-hero-panel {
    position: absolute;
    left: 50%;
    bottom: var(--hero-edge);
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
  }
  /* One button, one control high: sixteen pixels tall, of frosted glass
     laid on the box (the colours blurred through it, a light hairline on its
     edge), slightly rounded and lifted off it by a soft shadow. */
  .landing-hero-actions { display: flex; flex-wrap: wrap; gap: calc(4px * var(--sf, 1)); }
  .landing-hero-button {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    height: calc(16px * var(--sf, 1));
    padding: 0 calc(4px * var(--sf, 1));
    border-radius: calc(4px * var(--sf, 1));
    background: rgb(255 255 255 / 0.72);
    -webkit-backdrop-filter: blur(12px) saturate(1.5);
    backdrop-filter: blur(12px) saturate(1.5);
    color: #1e1e1e;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.65),
      0 1px 2px rgb(0 0 0 / 0.1),
      0 4px 12px rgb(0 0 0 / 0.14);
    font-family: var(--typeface-regular);
    font-size: calc(14px * var(--sf, 1));
    line-height: 1;
    text-decoration: none;
    transition: background-color 120ms ease-out;
  }
  .landing-hero-button:hover { background: rgb(255 255 255 / 0.9); color: #1e1e1e; text-decoration: none; }
  .landing-hero-button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  /* In the Overview the whole cover stands in the column, a square sixteen grid squares each way,
     above the page's title; the name down its red column and short enough to fit; a picture's corners. */
  .landing-hero-frame {
    container-type: inline-size;
    margin-block: 0 var(--site-unit, 20px);
  }
  .landing-hero--embedded {
    --hero-scale: calc(100cqw / 320);
    --hero-title-column: 240;
    --hero-title-size: calc(32 * var(--hero-scale));
    --hero-edge: calc(8 * var(--hero-scale));
    height: auto;
    min-height: 0;
    aspect-ratio: 1;
    border-radius: var(--ds-radius, 4px);
  }
  .landing-hero--embedded .landing-hero-title { top: var(--hero-edge); }

  /* Upright, the screen shows less of the cover: the name keeps to the screen. */
  @media (max-aspect-ratio: 1/1) {
    /* The name stops above the words and buttons, which stack there. */
    .landing-hero:not(.landing-hero--embedded) {
      --hero-title-column: 240;
      --hero-title-size: min(12.5dvh, 45 * var(--hero-scale), (100dvh - 310px) / 7.2);
    }
    .landing-hero:not(.landing-hero--embedded) .landing-hero-title { left: min(calc(var(--hero-title-column) * var(--hero-scale)), calc(100vw - var(--hero-title-size) * 0.5 - var(--hero-edge))); }
    .landing-hero-actions { display: grid; justify-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .landing-hero-button { transition: none; }
  }
</style>
