---
// The page's title, in place of Starlight's PageTitle: Design system 1's display
// text, 20px on two squares. Starlight's "On this page" links to it as #_top.
// A layer's overview leads with the layer's colour square, as the directory and the rail do.
// The Overview's title stands under the cover.
import LandingHero from './LandingHero.astro';
import { ALL_LAYERS } from '../../../shared/component-directory';
const { entry, id } = Astro.locals.starlightRoute;
const { title } = entry.data;
const layerColours: Record<string, string> = { yellow: '#eaff00', 'light-green': '#99ff73', 'light-blue': '#ccccff', pink: '#f5aad1' };
const layer = ALL_LAYERS.find(layer => entry.id === `${layer.number}-${layer.name.toLowerCase()}/overview`);
---

{id === '' && <LandingHero embedded />}
<h1 id="_top" class="ds-text ds-text--display" class:list={{ 'layer-title': layer }}>{layer && <span class="layer-swatch" aria-hidden="true" style={`background:${layerColours[layer.color]}`}></span>}{title}</h1>

<style>
  .layer-title { display: flex; align-items: center; gap: calc(8px * var(--sf, 1)); }
  .layer-swatch { flex: none; width: calc(16px * var(--sf, 1)); height: calc(16px * var(--sf, 1)); }
</style>
