<div class="landing-backdrop" aria-hidden="true">
  <span class="landing-unit-measure"></span>
  <svg class="landing-confetti" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="landing-micro-pattern" width="4" height="10" patternUnits="userSpaceOnUse">
        <image href="/images/landing-micro-blocks.svg" width="4" height="10" />
      </pattern>
      <pattern id="landing-medium-pattern" width="8" height="20" patternUnits="userSpaceOnUse">
        <image href="/images/landing-micro-blocks.svg" width="8" height="20" />
      </pattern>
    </defs>
    <g fill="url(#landing-micro-pattern)"></g>
  </svg>
</div>

<script>
  import { createLandingArtwork } from '../lib/landing-artwork';

  const backdrop = document.querySelector<HTMLElement>('.landing-backdrop');
  const landing = backdrop?.closest<HTMLElement>('.landing');
  if (backdrop && landing) {
    const measure = backdrop.querySelector<HTMLElement>('.landing-unit-measure')!;
    const confetti = backdrop.querySelector<SVGSVGElement>('.landing-confetti')!;
    let frame = 0;
    const render = () => {
      frame = 0;
      const bounds = backdrop.getBoundingClientRect();
      const unit = measure.getBoundingClientRect().width;
      if (!unit || !bounds.width || !bounds.height) return;
      const columns = bounds.width / unit;
      const rows = bounds.height / unit;
      const clearAreas = Array.from(landing.querySelectorAll<HTMLElement>(
        '.landing-content h1, .landing-content h2, .landing-content p, .landing-content pre, .landing-content nav, .landing-content button, .landing-content a, .layout-showcase'
      )).filter(element => element.getClientRects().length).map(element => {
        const rect = element.getBoundingClientRect();
        const isShowcase = element.matches('.layout-showcase');
        const padding = isShowcase ? 2 : 0.75;
        return {
          left: (rect.left - bounds.left) / unit - padding,
          top: isShowcase ? 0 : (rect.top - bounds.top) / unit - padding,
          right: (rect.right - bounds.left) / unit + padding,
          bottom: isShowcase ? rows : (rect.bottom - bounds.top) / unit + padding,
        };
      });
      const artwork = createLandingArtwork(columns, rows, clearAreas);
      confetti.setAttribute('viewBox', `0 0 ${columns} ${rows}`);
      confetti.querySelector('g')!.innerHTML = artwork.tiles.map(tile =>
        `<rect x="${tile.x}" y="${tile.y}" width="${tile.size}" height="${tile.size}"${tile.color ? ` fill="${tile.color}"` : tile.size === 0.5 ? ' fill="url(#landing-medium-pattern)"' : ''} />`
      ).join('');
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
    const resize = new ResizeObserver(schedule);
    resize.observe(backdrop);
    resize.observe(measure);
    landing.querySelectorAll('.landing-content, .layout-showcase').forEach(element => resize.observe(element));
    landing.querySelectorAll('[data-layout-direction]').forEach(button => button.addEventListener('click', schedule));
    document.fonts.addEventListener('loadingdone', schedule);
    void document.fonts.ready.then(schedule);
    schedule();
  }
</script>

<style>
  .landing-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .landing-unit-measure {
    position: absolute;
    width: var(--landing-unit);
    height: 0;
    visibility: hidden;
  }
  .landing-backdrop svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
</style>
