---
interface Props { product?: string; file?: string; download?: string; }
const { product = 'Money', file = 'phone-video', download = 'VisualKit-phone-example.mp4' } = Astro.props;
const base = `/examples/visual-kit/${file}`;
---
<figure class="phone-video not-content" data-ds-not-prose data-product={product}>
  <video controls playsinline preload="metadata" poster={`${base}.png`} width="1080" height="1920" aria-label={`${product} sample screen playing inside its original iPhone frame`}>
    <source src={`${base}.mp4`} type="video/mp4" />
    <a href={`${base}.mp4`}>Download the phone video</a>
  </video>
  <figcaption>{product}’s sample screen inside the original iPhone frame. Eight seconds, with the status and Safari bars included.</figcaption>
  <p><a href={`${base}.mp4`} download={download}>Download MP4</a></p>
</figure>
<style>
  .phone-video { margin:calc(20px * var(--sf,1)) 0; }
  video { display:block; width:min(100%,400px); height:auto; margin-inline:auto; background:white; }
  figcaption,p { margin-block:calc(20px * var(--sf,1)); }
  a { color:inherit; }
</style>
