---
import { EXAMPLES } from '../lib/component-examples';
import ExampleCode from './ExampleCode.astro';
interface Props { example: string; compact?: boolean; }
const { example, compact = false } = Astro.props;
const sample = EXAMPLES[example];
if (!sample) throw new Error(`Unknown component example: ${example}`);
---
<section class="component-example not-content" data-ds-not-prose data-example={example} aria-label={sample.title}>
  <div class="example-toolbar">
    <span>{sample.title}</span>
    <div class="example-toolbar-actions">
      <ds-button split literal aria-label="Preview appearance" options="light:Light,dark:Dark" value="light" data-preview-theme></ds-button>
      <ds-button control="slotted"><button type="button" data-preview-reset>Reset</button></ds-button>
    </div>
  </div>
  <iframe src={`/examples/${example}/`} title={`${sample.title} — interactive preview`} loading="lazy" style={`height: ${sample.height ?? 160}px;`} data-preview-frame></iframe>
  <p class="example-hint">{sample.hint}</p>
  <ExampleCode html={sample.html} script={sample.script} open={!compact} />
</section>
<script>
  import { onChoice } from '../lib/example-controls';
  document.querySelectorAll<HTMLElement>('section[data-example]').forEach(example => {
    const frame = example.querySelector<HTMLIFrameElement>('iframe')!;
    let theme = 'light';
    const sendTheme = () => frame.contentWindow?.postMessage({ type: 'ds1-example-theme', theme }, location.origin);
    frame.addEventListener('load', sendTheme);
    window.addEventListener('message', event => {
      if (event.origin === location.origin && event.source === frame.contentWindow && event.data?.type === 'ds1-example-ready') sendTheme();
    });
    onChoice(example.querySelector('[data-preview-theme]'), value => { theme = value; sendTheme(); });
    example.querySelector('[data-preview-reset]')?.addEventListener('click', () => { frame.src = frame.src; });
  });
</script>
<style is:global>
  .component-example { --example-unit: calc(20px * var(--sf, 1)); margin-block: var(--example-unit); color: var(--text-color); border-block: 1px solid var(--slate-light); font-size: 14px; line-height: var(--example-unit); }
  .component-example .example-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: calc(var(--example-unit) / 2); padding-block: calc(var(--example-unit) / 2); }
  .component-example .example-toolbar-actions { display: flex; align-items: center; gap: calc(var(--example-unit) / 2); }
  .component-example iframe { display: block; width: 100%; border: 0; background: var(--background); }
  .component-example .example-hint { margin: calc(var(--example-unit) / 2) 0; font-size: 14px; color: var(--text-color); }
  @media (prefers-color-scheme: dark) { .component-example { border-color: var(--slate-dark); } }
</style>
