---
import "../styles/component-example.css";
import { EXAMPLES } from '../lib/examples';
import ExampleCode from './ExampleCode.astro';
import ExampleViewToggle from './ExampleViewToggle.astro';
interface Props { example: string; compact?: boolean; }
const { example } = Astro.props;
const sample = EXAMPLES[example];
if (!sample) throw new Error(`Unknown component example: ${example}`);
---
<section class="component-example not-content" data-ds-not-prose data-example-view data-example={example} aria-label={sample.title}>
  <div class="example-toolbar">
    <span>{sample.title}</span>
    <ExampleViewToggle />
  </div>
  <div data-example-preview>
  <iframe src={`/examples/${example}/`} title={`${sample.title} — interactive preview`} loading="lazy" scrolling="no" style={`height: ${sample.height ?? 160}px;`} data-fit={sample.fit} data-preview-frame></iframe>
  <p class="example-hint">{sample.hint}</p>
  </div>
  <div data-example-source hidden><ExampleCode html={sample.html} script={sample.script} /></div>
</section>
<script>
  import { fitFrame, followPageTheme } from '../lib/example-controls';
  document.querySelectorAll<HTMLElement>('section[data-example]').forEach(example => {
    const frame = example.querySelector<HTMLIFrameElement>('iframe')!;
    followPageTheme(frame);
    fitFrame(frame);
  });
</script>

