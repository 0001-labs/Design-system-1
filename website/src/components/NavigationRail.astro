---
const { sidebar } = Astro.locals.starlightRoute;
type Entry = { label: string; href?: string; entries?: Entry[] };
// This compact navigation is app-owned; it adds no public component icons.
function flatten(entries: Entry[], section = ''): { name: string; href: string; marker?: string; section: string }[] {
  return entries.flatMap(entry => {
    const layer = entry.label.match(/^([1-4]) (Root|Core|Unit|Page)$/);
    const currentSection = layer?.[1] ?? section;
    const href = entry.href ?? (layer ? `/${layer[1]}-${layer[2].toLowerCase()}/overview/` : undefined);
    return [...(href ? [{ name: entry.label, href, marker: layer?.[1], section: currentSection }] : []), ...flatten(entry.entries ?? [], currentSection)];
  });
}
const entries = flatten(sidebar);
---
<nav class="docs-navigation-rail" aria-label="Documentation shortcuts">
  <ds-button control="slotted" icon class="rail-open">
    <button id="sidebar-rail-open" type="button" aria-label="Expand sidebar"><ds-icon type="right" aria-hidden="true" /></button>
  </ds-button>
  {entries.map(entry => <ds-button control="slotted" primary={entry.marker ? '' : undefined} fit class="rail-entry" data-section={entry.section} data-rail-layer={entry.marker} aria-label={entry.name}>
    <a href={entry.href} aria-label={entry.name} aria-current={entry.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '') ? 'page' : undefined}>{entry.name}</a>
  </ds-button>)}
</nav>
<script>
  import '../../../DS1/2-core/ds-icon';
  import { readAppComponents } from '../lib/app-navigation';
  import { setSidebarCollapsed } from '../lib/sidebar-state';
  document.getElementById('sidebar-rail-open')?.addEventListener('click', () => {
    setSidebarCollapsed(false);
    document.querySelector<HTMLButtonElement>(document.documentElement.hasAttribute('data-signed-in') ? '#workspace-hide button' : '#public-sidebar-hide button')?.focus();
  });
  const rail = document.querySelector<HTMLElement>('.docs-navigation-rail');
  window.addEventListener('ds1-navigation-auth', event => {
    const detail = (event as CustomEvent).detail;
    if (detail.loading) return;
    rail?.querySelectorAll('[data-private-rail]').forEach(button => button.remove());
    for (const component of readAppComponents(detail)) {
      const heading = rail?.querySelector(`[data-rail-layer="${component.layer}"]`);
      if (!heading) continue;
      const button = document.createElement('ds-button');
      button.className = 'rail-entry';
      button.setAttribute('control', 'slotted');
      button.setAttribute('fit', '');
      button.dataset.section = String(component.layer);
      button.dataset.privateRail = '';
      button.setAttribute('aria-label', component.name);
      const link = document.createElement('a');
      link.href = component.href;
      link.setAttribute('aria-label', component.name);
      link.textContent = component.name;
      button.append(link);
      let next = heading.nextElementSibling;
      while (next && !next.hasAttribute('data-rail-layer') && (next.getAttribute('aria-label') ?? '').localeCompare(component.name, 'en') < 0) next = next.nextElementSibling;
      rail!.insertBefore(button, next);
    }
  });
</script>
<style>
  .docs-navigation-rail { display: none; }
  @media (min-width: 769px) {
    :global(html[data-sidebar-collapsed]) .docs-navigation-rail { display: flex; flex-direction: column; width: calc(8 * var(--site-unit)); padding: var(--site-unit) calc(var(--site-unit) / 2) var(--site-unit) var(--site-unit); }
    .rail-open { align-self: flex-start; flex: none; margin-bottom: var(--site-unit); }
    .docs-navigation-rail :global(.rail-entry) { --section-color: var(--light-grey); --ds-button-text-color: var(--text-color); height: var(--site-unit); align-items: flex-end; align-self: flex-start; }
    .docs-navigation-rail :global([data-section='1']) { --section-color: var(--yellow); }
    .docs-navigation-rail :global([data-section='2']) { --section-color: var(--apple-green); }
    .docs-navigation-rail :global([data-section='3']) { --section-color: var(--zenith-blue); }
    .docs-navigation-rail :global([data-section='4']) { --section-color: var(--pink); }
    .docs-navigation-rail :global([data-rail-layer]) { --ds-button-background-color-primary: var(--section-color); --ds-button-text-color-on-accent: var(--black); }
    .docs-navigation-rail :global(.rail-entry:has(a[aria-current])) { outline: 1px solid var(--sharp-blue); outline-offset: 1px; }
  }
</style>
