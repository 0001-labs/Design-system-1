---
const { sidebar } = Astro.locals.starlightRoute;
type Entry = { label: string; href?: string; entries?: Entry[] };
// The documentation's one navigation on a wider screen, always shown: each group a square below the
// last under its name, a layer's name after its colour's square and linked to its overview, and its
// pages one a line. It is app-owned and adds no public component icons.
type RailRow = { name: string; href?: string; layer?: string; heading?: boolean; gap?: boolean; section: string };
const sentence = (label: string) => label.charAt(0) + label.slice(1).toLowerCase();
function flatten(entries: Entry[], section = ''): RailRow[] {
  return entries.flatMap((entry, index) => {
    const layer = entry.label.match(/^([1-4]) (Root|Core|Unit|Page)$/);
    if (entry.entries) {
      const currentSection = layer?.[1] ?? entry.label;
      const heading: RailRow = layer
        ? { name: layer[2], href: `/${layer[1]}-${layer[2].toLowerCase()}/overview/`, layer: layer[1], heading: true, gap: index > 0, section: currentSection }
        : { name: sentence(entry.label), heading: true, gap: index > 0, section: currentSection };
      return [heading, ...flatten(entry.entries, currentSection)];
    }
    if (!entry.href) return [];
    // A page standing on its own between groups starts a square below them too.
    return [{ name: entry.label, href: entry.href, gap: !section && index > 0 && Boolean(entries[index - 1]?.entries), section }];
  });
}
const rows = flatten(sidebar);
const here = Astro.url.pathname.replace(/\/$/, '');
---
<nav class="docs-navigation-rail" aria-label="Documentation shortcuts">
  <div class="rail-links">
  {rows.map(row => row.href
    ? <ds-button control="slotted" fit class:list={['rail-entry', { 'rail-heading': row.heading, 'rail-gap': row.gap }]} data-section={row.section} data-rail-layer={row.layer} aria-label={row.name}>
        <a href={row.href} aria-label={row.name} aria-current={row.href.replace(/\/$/, '') === here ? 'page' : undefined}>{row.layer && <span class="rail-swatch" aria-hidden="true"></span>}{row.name}</a>
      </ds-button>
    : <p class:list={['rail-group', { 'rail-gap': row.gap }]}>{row.name}</p>)}
  </div>
  <footer class="rail-footer">
    <ds-button control="slotted" fit><a href="https://github.com/0001-labs/Design-system-1">GitHub</a></ds-button>
    <ds-button control="slotted" fit><a id="rail-account" href="/app/signin">Sign in</a></ds-button>
  </footer>
</nav>
<script>
  import '../../../DS1/2-core/ds-icon';
  import { readAppComponents } from '../lib/app-navigation';
  const rail = document.querySelector<HTMLElement>('.rail-links');
  const account = document.querySelector<HTMLAnchorElement>('#rail-account');
  function renderAccount(signedIn: boolean) {
    if (!account) return;
    account.href = signedIn ? '/app/profile' : '/app/signin';
    account.textContent = signedIn ? 'Profile' : 'Sign in';
  }
  renderAccount(document.documentElement.hasAttribute('data-signed-in'));
  window.addEventListener('ds1-navigation-auth', event => {
    const detail = (event as CustomEvent).detail;
    if (detail.loading) return;
    renderAccount(detail.authenticated === true);
    rail?.querySelectorAll('[data-private-rail]').forEach(button => button.remove());
    for (const component of readAppComponents(detail)) {
      const heading = rail?.querySelector(`[data-rail-layer="${component.layer}"]`);
      if (!heading) continue;
      const button = document.createElement('ds-button');
      button.className = 'rail-entry';
      button.setAttribute('control', 'slotted');
      button.setAttribute('fit', '');
      button.dataset.section = String(component.layer);
      button.dataset.privateRail = '';
      button.setAttribute('aria-label', component.name);
      const link = document.createElement('a');
      link.href = component.href;
      link.setAttribute('aria-label', component.name);
      link.textContent = component.name;
      button.append(link);
      let next = heading.nextElementSibling;
      while (next && !next.hasAttribute('data-rail-layer') && (next.getAttribute('aria-label') ?? '').localeCompare(component.name, 'en') < 0) next = next.nextElementSibling;
      rail!.insertBefore(button, next);
    }
  });
</script>
<style>
  .docs-navigation-rail { display: none; }
  @media (min-width: 769px) {
    :global(html[data-sidebar-collapsed]) .docs-navigation-rail { display: flex; flex-direction: column; width: calc(8 * var(--site-unit)); height: 100%; padding: var(--site-unit) calc(var(--site-unit) / 2) var(--site-unit) var(--site-unit); }
    .rail-links { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; }
    .rail-links::-webkit-scrollbar { display: none; }
    .rail-footer { display: flex; align-items: flex-end; justify-content: space-between; flex: none; height: calc(2 * var(--site-unit)); border-top: 1px solid var(--ds1-docs-header-border); }
    .rail-links > :global(.rail-gap) { margin-top: var(--site-unit); }
    .rail-group { flex: none; height: var(--site-unit); margin: 0; padding: 0; font-size: var(--ds-type-size-default, calc(14px * var(--sf, 1))); color: var(--ds-text-color-muted, var(--text-color)); line-height: var(--site-unit); }
    .docs-navigation-rail :global(.rail-heading a) { display: inline-flex; align-items: flex-end; gap: calc(4px * var(--sf, 1)); }
    .docs-navigation-rail :global(.rail-swatch) { flex: none; width: calc(10px * var(--sf, 1)); height: calc(10px * var(--sf, 1)); margin-bottom: calc(3px * var(--sf, 1)); border-radius: calc(2px * var(--sf, 1)); background: var(--section-color); }
    .docs-navigation-rail :global(.rail-entry) { --section-color: var(--light-grey); --ds-button-text-color: var(--text-color); height: var(--site-unit); align-items: flex-end; align-self: flex-start; }
    .docs-navigation-rail :global([data-section='1']) { --section-color: var(--yellow); }
    .docs-navigation-rail :global([data-section='2']) { --section-color: var(--apple-green); }
    .docs-navigation-rail :global([data-section='3']) { --section-color: var(--zenith-blue); }
    .docs-navigation-rail :global([data-section='4']) { --section-color: var(--pink); }
    .docs-navigation-rail :global(.rail-entry:has(a[aria-current])) { outline: 1px solid var(--sharp-blue); outline-offset: 1px; }
  }
</style>
