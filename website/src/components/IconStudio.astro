---
import InterfaceIcons from './InterfaceIcons.astro';
import interfaceIcons from '../lib/icons/interface-catalog.json';
import { PRODUCTS, drawingSvg } from '../lib/icons/studio';
import { FIGMA_ICONS } from '../lib/icons/gridIconFigma';
import '../styles/icons/studio.css';
---
    <div class="docs-tool not-content"><div id="icon-studio" class="icon-tool">
      <div class="studio-tabs" role="tablist" aria-label="Icon collections"><button id="interface-tab" role="tab" aria-selected="true" aria-controls="interface-panel">Interface icons <span>{interfaceIcons.length}</span></button><button id="badge-tab" role="tab" aria-selected="false" aria-controls="badge-panel" tabindex="-1">Badges & favicons</button></div>
      <InterfaceIcons />
      <div id="badge-panel" role="tabpanel" aria-labelledby="badge-tab" hidden>
      <section class="company-favicons" aria-label="0001 favicons">
        <div><h2>0001</h2><p>The original 1. Light and dark.</p><a href="/icons/0001.svg" download="0001.svg">Download automatic SVG ↓</a></div>
        {['light', 'dark'].map(theme => <div class="company-favicon"><img src={`/icons/0001-${theme}.svg`} width="38" height="38" alt={`0001 ${theme} favicon`} /><span>{theme === 'light' ? 'Light' : 'Dark'}</span><a href={`/icons/0001-${theme}.svg`} download>SVG ↓</a><a href={`/icons/0001-${theme}.ico`} download>ICO ↓</a></div>)}
      </section>
      <div class="workspace">
        <aside class="library" aria-label="Icon library">
          <div class="section-heading"><h2>Starting points</h2><span>{PRODUCTS.length} concepts</span></div>
          <div class="products" id="products">
            {PRODUCTS.map((preset, index) => <button class="product" data-product={preset.key} aria-pressed={index === 0}>
              <span class="product-image" set:html={drawingSvg(preset, 36, 'product-' + preset.key)} />
              <span><strong>{preset.name}</strong><small>{preset.key === 'fan' ? 'Original collection' : preset.key === 'design-system-1' ? 'Packaging mosaic' : 'Favicon concept'}</small></span><span class="product-arrow" aria-hidden="true">↗</span>
            </button>)}
          </div>
          <div class="section-heading collection-heading"><h2>Original collection</h2><span>{FIGMA_ICONS.length} icons</span></div>
          <p class="section-note">The original shapes. Ready to refine.</p>
          <div class="collection" id="collection">
            {FIGMA_ICONS.map(preset => <button data-original={preset.key} title={preset.name} aria-label={`Edit ${preset.name}`} set:html={drawingSvg({name:preset.name,icon:preset.icon,radius:0,padding:0}, 28, 'original-'+preset.key)} />)}
          </div>
          <button class="text-button new-drawing" id="new-drawing">＋ Start with an empty canvas</button>
          <div class="section-heading collection-heading"><h2>Your shelf</h2><button class="text-button" id="save-drawing">＋ Save</button></div>
          <div id="shelf" class="collection"></div><p class="section-note" id="shelf-note">Keep a few favourites in this browser.</p>
        </aside>
        <section class="editor" aria-label="Icon editor">
          <div class="editor-heading"><label class="sr-only" for="drawing-name">Icon name</label><input id="drawing-name" value="Design System 1" maxlength="80" /><span id="save-state">Saved locally</span></div>
          <div class="toolbar" aria-label="Drawing tools">
            <div class="segmented" id="tools">
              <button data-tool="paint" aria-pressed="true" title="Paint · P">Paint</button><button data-tool="triangle" aria-pressed="false" title="Triangle · T">Triangle</button><button data-tool="erase" aria-pressed="false" title="Erase · E">Erase</button>
            </div>
            <div class="history-tools"><button id="undo" aria-label="Undo" title="Undo · ⌘Z" disabled>↶</button><button id="redo" aria-label="Redo" title="Redo · ⇧⌘Z" disabled>↷</button></div>
          </div>
          <div class="drawing-space">
            <div class="ruler ruler-top" aria-hidden="true"><span>0</span><span>4</span><span>8</span><span>12</span><span>16</span></div>
            <div id="canvas" tabindex="0" role="application" aria-label="16 by 16 icon drawing grid" aria-describedby="canvas-help"><div id="artwork"></div><svg id="overlay" viewBox="0 0 16 16" aria-hidden="true"></svg></div>
            <p id="canvas-help">Drag to draw. Arrow keys + Space work too. Padding appears below.</p>
          </div>
          <div class="canvas-footer"><label><input type="checkbox" id="show-grid" checked /> Grid</label><label>Brush <select id="brush"><option value="1">1 × 1</option><option value="2" selected>2 × 2</option><option value="4">4 × 4</option><option value="8">8 × 8</option></select></label><div><button id="rotate" class="text-button">Rotate ↻</button><button id="flip" class="text-button">Flip ↔</button></div></div>
          <p id="drawing-description" class="drawing-description">The square colour mosaic from the packaging.</p>
        </section>
        <aside class="inspector" aria-label="Icon settings and export">
          <div class="section-heading"><h2>Make it yours</h2><span>16 × 16</span></div>
          <fieldset><legend>Inks</legend><div id="inks" class="inks"></div><div class="ink-edit"><label class="sr-only" for="ink-color">Selected ink colour</label><input type="color" id="ink-color" value="#b6ff60" /><label class="sr-only" for="ink-hex">Hex colour</label><input id="ink-hex" value="#b6ff60" maxlength="9" spellcheck="false" /><button id="add-ink" aria-label="Add ink">＋</button><button id="remove-ink" aria-label="Remove selected ink">−</button></div><div id="palette" class="palette"></div></fieldset>
          <fieldset><legend>Shape</legend><div id="masks" class="segmented"><button data-mask="square" aria-pressed="true">Square</button><button data-mask="circle" aria-pressed="false">Circle</button></div><label class="range-label" for="radius">Corners <output id="radius-value">2</output></label><input type="range" id="radius" min="0" max="8" step="0.5" value="2" /><label class="range-label" for="padding">Breathing room <output id="padding-value">0</output></label><input type="range" id="padding" min="0" max="4" step="0.5" value="0" /></fieldset>
          <fieldset><legend>Pattern</legend><label class="sr-only" for="pattern">Pattern</label><div class="pattern-row"><select id="pattern"><option value="">Choose a pattern…</option></select><button id="recolor" title="Try another palette" aria-label="Try another palette">↻</button></div></fieldset>
          <div class="export"><div class="section-heading"><h2>Take it with you</h2></div><button id="download-svg" class="primary">Download SVG <span>↓</span></button><div class="export-row"><button id="download-png">PNG · 512</button><button id="download-ico">Favicon .ico</button></div><div class="export-row subtle"><button id="copy-svg">Copy SVG</button><button id="download-json">Save file</button><button id="import-json">Open file</button></div><input type="file" id="file-input" accept="application/json,.json" hidden /><p class="section-note">Vector, high resolution, or 16–256 px favicon.</p></div>
        </aside>
      </div>
      <section class="preview-section" aria-label="Icon previews"><div class="section-heading"><h2>The small details matter</h2><span>Actual size previews</span></div><div class="previews"><div class="size-card" id="light-preview"></div><div class="size-card dark-preview" id="dark-preview"></div><div class="browser-preview"><div class="browser-tab"><span id="tab-icon"></span><span id="tab-title">Design System 1</span><span class="tab-close">×</span></div><div class="browser-address">↗ <span>your-website.com</span></div><p>A little identity. Everywhere you open it.</p></div></div></section>
      </div>
      <p id="status" class="status" role="status" aria-live="polite"></p>
      <noscript><p class="no-script">Enable JavaScript to draw and export. The starting-point collection is available above.</p></noscript>
    </div></div>
    <script>import '../lib/icons/editor';</script>
