---
import ComponentExample from './ComponentExample.astro';
import { PAGE_EXAMPLES } from '../lib/component-examples';
import '../../../DS1/1-root/one.css';
import { LAYERS } from '../lib/component-directory';

// Root is files; every other layer is custom elements.
const inCode = (tag: string) => (tag.startsWith('ds-') ? `<${tag}>` : tag);
---
    <div class="docs-tool not-content"><div class="directory component-catalog" data-view="examples">
      <ds-button split literal class="directory-toggle" aria-label="Show components as" options="examples:Examples,names:Name,tags:<element>" value="examples" data-view-choice></ds-button>

      <div class="gallery-intro">
        <p>See the actual components. Try their controls, switch the preview’s theme, then copy the code.</p>
        <label for="component-search">Find a component</label>
        <ds-input id="component-search" type="search" placeholder="Button, tooltip, ds-input…"></ds-input>
        <p id="component-count" role="status" aria-live="polite"></p>
      </div>
      <div class="examples-gallery">
        {LAYERS.filter(layer => layer.number > 1).map(layer => (
          <section class="gallery-layer" aria-labelledby={`examples-layer-${layer.number}`}>
            <h2 id={`examples-layer-${layer.number}`}>{layer.number} {layer.name}</h2>
            <p>{layer.summary}</p>
            <div class="gallery-entries">
              {layer.entries.map(entry => {
                const example = PAGE_EXAMPLES[entry.href.replace(/^\/|\/$/g, '')]?.[0];
                return <article data-component-search={`${entry.name} ${entry.tag ?? ''} ${layer.name}`.toLowerCase()}>
                  <div class="gallery-entry-heading"><a href={entry.href}>{entry.name}</a>{entry.tag && <code>{`<${entry.tag}>`}</code>}</div>
                  {example ? <ComponentExample example={example} compact /> : <p><a href={entry.href}>Read the composition guide</a></p>}
                  <a class="gallery-docs-link" href={entry.href}>Usage and API</a>
                </article>;
              })}
            </div>
          </section>
        ))}
        <p id="component-empty" hidden>No components match. Try another name.</p>
      </div>
      {LAYERS.map((layer) => (
        <section class="directory-layer" data-color={layer.color} aria-labelledby={`layer-${layer.number}`}>
          <div class="directory-layer-head">
            <h2 id={`layer-${layer.number}`}><span class="directory-swatch" aria-hidden="true"></span>{layer.number} {layer.name}</h2>
            <p>{layer.summary}</p>
          </div>
          <ul>
            {layer.entries.map((entry) => (
              <li>
                <a href={entry.href} data-untagged={entry.tag ? undefined : ''}>
                  <span class="directory-name">{entry.name}</span>
                  <span class="directory-tag">{entry.tag ? inCode(entry.tag) : entry.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

    </div></div>

    <script>
      import { onChoice } from '../lib/example-controls';
      const root = document.querySelector<HTMLElement>('.component-catalog')!;
      try { const saved = localStorage.getItem('ds1-directory-view'); if (saved === 'tags' || saved === 'names') root.dataset.view = saved; } catch {}
      const choice = root.querySelector<HTMLElement & { value: string }>('[data-view-choice]')!;
      choice.setAttribute('value', root.dataset.view ?? 'examples');
      onChoice(choice, view => {
        root.dataset.view = view;
        try { localStorage.setItem('ds1-directory-view', view); } catch {}
      });
      const search = document.querySelector<HTMLElement & { value: string }>('#component-search')!;
      const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-component-search]'));
      const filter = () => {
        const query = (search.value ?? '').trim().toLowerCase();
        entries.forEach(entry => { entry.hidden = !entry.dataset.componentSearch!.includes(query); });
        document.querySelectorAll<HTMLElement>('.gallery-layer').forEach(layer => { layer.hidden = !layer.querySelector('[data-component-search]:not([hidden])'); });
        const count = entries.filter(entry => !entry.hidden).length;
        document.querySelector('#component-count')!.textContent = `${count} components and composition guides`;
        (document.querySelector('#component-empty') as HTMLElement).hidden = count !== 0;
      };
      search.addEventListener('input', filter);
      filter();
    </script>

    <style is:global>
.component-catalog {
      #layer-x { font-family: var(--typeface-regular); font-weight: 400; }
      .section-cross { display: inline-flex; width: calc(16px * var(--sf, 1)); height: calc(16px * var(--sf, 1)); }
      .section-cross svg { width: 100%; height: 100%; }
      .examples-gallery, .gallery-intro { display: none; }
      &[data-view='examples'] .directory-layer { display: none; }
      &[data-view='examples'] :is(.examples-gallery, .gallery-intro) { display: block; }
      .gallery-intro { margin-bottom: calc(40px * var(--sf, 1)); max-width: calc(640px * var(--sf, 1)); }
      .gallery-intro p { margin: 0 0 calc(20px * var(--sf, 1)); }
      .gallery-intro label { display: block; }
      .gallery-intro ds-input { display: block; width: 100%; }
      .gallery-intro #component-count { font-size: 10px; margin: 0; }
      .gallery-layer { border-top: 1px solid var(--directory-line); padding-block: calc(20px * var(--sf, 1)); }
      .gallery-layer h2 { margin: 0; font-size: 17px; font-weight: 400; }
      .gallery-layer > p { margin: 0 0 calc(20px * var(--sf, 1)); }
      .gallery-entries { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, calc(400px * var(--sf, 1))), 1fr)); gap: calc(40px * var(--sf, 1)); }
      .gallery-entry-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: calc(10px * var(--sf, 1)); }
      .gallery-entry-heading a { font-size: 17px; text-decoration: underline; text-underline-offset: 4px; }
      .gallery-entry-heading code { font-size: 13px; color: var(--directory-muted); }
      .gallery-docs-link { text-decoration: underline; text-underline-offset: 4px; }
      [hidden] { display: none !important; }
      & {
        color-scheme: light dark;
        --directory-bg: light-dark(#ffffff, #171717);
        --directory-ink: light-dark(#1e1e1e, #f1f1f1);
        --directory-muted: light-dark(#6b6b6b, #a8a8a8);
        --directory-line: light-dark(#e0e0e0, #333333);
        --directory-edge: clamp(16px, 2.5vw, 40px);
      }
      * { box-sizing: border-box; }
      & { margin: 0; }
      & {
        background: var(--directory-bg);
        color: var(--directory-ink);
        font-family: var(--typeface-regular, 'GT-America-Standard-Regular'), -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 14px;
        line-height: 20px;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      :is(a, button):focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

      .directory-toggle { margin-block: var(--site-unit); }

      & { padding: 0; }
      .directory h1 {
        margin: 0 0 calc(40px * var(--sf, 1));
        color: var(--directory-muted);
        font-size: 14px;
        font-weight: 400;
      }
      .directory-layer {
        --layer-color: light-dark(#e6e6e6, #ffffff);
        display: grid;
        grid-template-columns: minmax(180px, 1fr) 4fr;
        gap: 16px clamp(16px, 3vw, 48px);
        padding-block: clamp(20px, 3vw, 40px) clamp(40px, 7vw, 112px);
        border-top: 1px solid var(--directory-line);
      }
      .directory-layer[data-color='light-green'] { --layer-color: #99ff73; }
      .directory-layer[data-color='light-blue'] { --layer-color: #ccccff; }
      .directory-layer[data-color='pink'] { --layer-color: #f5aad1; }
      .directory-layer[data-color='yellow'] { --layer-color: #eaff00; }
      .directory-layer-head code { font: inherit; }
      /* An icon stands before its name at the name's own height. */
      .directory-layer.directory-layer--icons li a { display: flex; align-items: center; gap: 0.18em; }
      .directory-icon { display: block; flex: none; width: 0.82em; height: 0.82em; }
      .directory-icon svg { display: block; width: 100%; height: 100%; }
      &[data-view='tags'] .directory-layer.directory-layer--icons li a { font-size: clamp(22px, 4.6vw, 84px); }
      .directory-layer-head { position: sticky; top: 88px; align-self: start; }
      .directory-layer h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 6px;
        font-family: var(--typeface-medium, inherit);
        font-size: 14px;
        font-weight: 400;
      }
      .directory-swatch { width: 16px; height: 16px; background: var(--layer-color); }
      .directory-layer-head p { max-width: 24ch; margin: 0; color: var(--directory-muted); }
      .directory-layer ul { margin: 0; padding: 0; list-style: none; }

      /* The names are the buttons: one a line, as large as the screen allows. */
      .directory-layer li a {
        display: block;
        width: fit-content;
        max-width: 100%;
        padding: 0 0.08em 0.04em;
        margin-inline-start: -0.08em;
        font-size: clamp(44px, 9.5vw, 168px);
        letter-spacing: -0.035em;
        line-height: 1;
        overflow-wrap: anywhere;
        transition: background-color 120ms ease-out;
      }
      .directory-layer li a:hover { background: var(--layer-color); color: #1e1e1e; }
      .directory-tag { display: none; }
      &[data-view='tags'] .directory-name { display: none; }
      &[data-view='tags'] .directory-tag { display: inline; }
      &[data-view='tags'] .directory-layer li a { font-size: clamp(34px, 7.6vw, 136px); }
      /* Documented, with no element of its own to write. */
      &[data-view='tags'] .directory-layer li a[data-untagged] { color: var(--directory-muted); }

      @container tool (max-width: 720px) {
        .directory-layer { grid-template-columns: 1fr; }
        .directory-layer-head { position: static; }
      }
      @media (prefers-reduced-motion: reduce) {
        .directory-layer li a { transition: none; }
      }
}
    </style>
