---
interface Props { title: string; src: string; height: number; }
const { title, src, height } = Astro.props;
---
<div class="example-device" style={`--example-height: ${height}px;`}>
  <div class="example-device-glass">
    <div class="example-window-chrome" aria-hidden="true">
      <i></i><i></i><i></i><span>{title}</span>
    </div>
    <img class="example-phone-status" src="/examples/device/iphone-status.webp" width="808" height="125" alt="" loading="lazy" />
    <iframe src={src} title={`${title} — interactive preview`} loading="lazy"></iframe>
    <div class="example-phone-home" aria-hidden="true"></div>
  </div>
  <img class="example-phone-frame" src="/examples/device/iphone-frame.webp" width="910" height="1855" alt="" loading="lazy" />
</div>
<style is:global>
  .example-device {
    position: relative;
    width: 100%;
    margin-inline: auto;
    --device-scale: var(--sf, 1);
    --device-paper: var(--background);
  }
  .example-device-glass {
    overflow: hidden;
    border-radius: calc(12px * var(--device-scale));
    background: var(--device-paper);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--text-color) 18%, transparent), 0 calc(22px * var(--device-scale)) calc(45px * var(--device-scale)) rgb(0 0 0 / .15);
  }
  .example-window-chrome { position: relative; height: calc(34px * var(--device-scale)); pointer-events: none; }
  .example-window-chrome i { position: absolute; top: calc(12px * var(--device-scale)); left: calc(14px * var(--device-scale)); width: calc(10px * var(--device-scale)); height: calc(10px * var(--device-scale)); border-radius: 50%; background: #ff5f57; }
  .example-window-chrome i:nth-child(2) { left: calc(30px * var(--device-scale)); background: #febc2e; }
  .example-window-chrome i:nth-child(3) { left: calc(46px * var(--device-scale)); background: #28c840; }
  .example-window-chrome span { position: absolute; inset: calc(8px * var(--device-scale)) calc(70px * var(--device-scale)) auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; font-size: calc(10px * var(--device-scale)); line-height: calc(20px * var(--device-scale)); }
  .example-device iframe { display: block; width: 100%; height: var(--example-height); margin: 0; border: 0; background: var(--device-paper); }
  .example-phone-status, .example-phone-frame, .example-phone-home { display: none; }
  [data-phone] .example-device { width: calc(21 * var(--layout-unit)); max-width: 100%; aspect-ratio: 910 / 1855; }
  /* The supplied artwork's screen is 1622/1819 wide, inset 98/1819 and 60/3710 down. */
  [data-phone] .example-device-glass { position: absolute; top: calc(100% * 60 / 3710); left: calc(100% * 98 / 1819); width: calc(100% * 1622 / 1819); height: calc(100% * 1622 / 1819 * 2.212 * 910 / 1855); border-radius: 14.2857% / 6.4583%; box-shadow: none; display: flex; flex-direction: column; }
  [data-phone] .example-window-chrome { display: none; }
  [data-phone] .example-phone-status { display: block; flex: none; width: 100%; height: auto; pointer-events: none; user-select: none; }
  [data-phone] .example-device iframe { flex: 1; min-height: 0; height: 0; }
  [data-phone] .example-phone-home { display: grid; flex: none; height: 4%; place-items: center; }
  [data-phone] .example-phone-home::after { content: ''; width: 34%; height: 15%; border-radius: 999px; background: var(--text-color); }
  [data-phone] .example-phone-frame { position: absolute; display: block; inset: 0; width: 100%; height: 100%; pointer-events: none; user-select: none; }
  html.dark-theme [data-phone] .example-phone-status { filter: invert(1); }
</style>
