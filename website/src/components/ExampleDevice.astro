---
interface Props { title: string; src: string; height: number; }
const { title, src, height } = Astro.props;
---
<div class="example-device" style={`--example-height: ${height}px;`}>
  <ds-window class="example-device-glass" kind="macos-compact" label={title} address={src}>
    <ds-device-bezel frameless asset-base="/examples/visual-kit/" browser="safari" time="00:01" address={src}>
      <iframe src={src} title={`${title} — interactive preview`} loading="lazy"></iframe>
    </ds-device-bezel>
  </ds-window>
</div>
<script>
  import '../../../DS1/2-core/ds-window';
  import '../../../DS1/2-core/ds-device-bezel';
  document.querySelectorAll<HTMLElement>('.example-device').forEach(example=>{
    const container=example.closest('[data-preview-width]')?.parentElement || example.closest('.layout-example,.play,.examples-card,.not-content') || example.parentElement!;
    const update=()=>{const phone=!!example.closest('[data-phone]');const window=example.querySelector('ds-window')!;const bezel=example.querySelector('ds-device-bezel')!;window.frameless=phone;bezel.frameless=!phone;window.appearance=bezel.appearance=document.documentElement.classList.contains('dark-theme')?'dark':'light';};
    new MutationObserver(update).observe(container,{attributes:true,subtree:false});
    container.addEventListener('example-device-change',update);
    new MutationObserver(update).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
    update();
  });
</script>
<style is:global>
  [data-global-example-device] [data-preview-width]{display:none}
  .example-device{position:relative;width:100%;margin-inline:auto}
  .example-device-glass{--ds-window-height:calc(var(--example-height) + 20px)}
  .example-device iframe{display:block;width:100%;height:var(--example-height);border:0;background:var(--background)}
  [data-phone] .example-device{width:calc(21 * 20px * var(--sf,1));max-width:100%}
  [data-phone] .example-device ds-device-bezel{--ds-device-width:100%;width:100%}
  [data-phone] .example-device iframe{height:100%!important}
  [data-tablet] .example-device{width:calc(40 * 20px * var(--sf,1));max-width:100%}
</style>
