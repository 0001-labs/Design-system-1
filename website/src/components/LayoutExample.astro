---
import { LAYOUT_EXAMPLES } from '../lib/layout-examples';
import { layersIn } from '../lib/component-layers';
import ExampleCode from './ExampleCode.astro';
import ExampleViewToggle from './ExampleViewToggle.astro';
import ExampleDevice from './ExampleDevice.astro';
interface Props { layout: string; }
const { layout } = Astro.props;
const sample = LAYOUT_EXAMPLES[layout];
if (!sample) throw new Error(`Unknown layout example: ${layout}`);
const inside = layersIn(sample.html);
// The code a reader copies loads the same library, after Design system 1's stylesheet.
const code = sample.library ? `<link rel="stylesheet" href="${sample.library.href}">\n${sample.html}` : sample.html;
---
<section class="layout-example not-content" data-ds-not-prose data-example-view data-layout-example={layout} aria-label={`${sample.name} layout`}>
  <div class="layout-toolbar">
    <ds-button split literal aria-label="Preview width" options="computer:Computer,phone:Phone" value="computer" data-preview-width></ds-button>
    <div class="layout-toolbar-end">
      <ds-button control="slotted" choice><button type="button" data-preview-layers aria-pressed="false">Show layers</button></ds-button>
      <a href={`/examples/layouts/${layout}/`} target="_blank" rel="noopener">Open full size</a>
      <ExampleViewToggle />
    </div>
  </div>
  <div data-example-preview>
  <div class="layout-stage">
    <ExampleDevice src={`/examples/layouts/${layout}/`} title={sample.name} height={sample.height} />
  </div>
  <p class="layout-readout" aria-live="polite" data-readout>Point at any part of the page to see what it is made of.</p>
  <div class="layout-inside">
    {inside.map(group => (
      <div data-layer={group.layer}>
        <p class="ds-row layer-name"><span class="layer-swatch" aria-hidden="true"></span>{group.name}</p>
        <ul aria-label={group.name}>
          {group.tags.map(item => <li><a class="ds-row ds-row--nav" href={item.href} aria-disabled={item.href ? undefined : 'true'}>{item.tag}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  </div>
  <div data-example-source hidden><ExampleCode html={code} script={sample.script} /></div>
</section>
<script>
  import '../../../DS1/1-root/row.css';
  import { onChoice, followPageTheme } from '../lib/example-controls';
  document.querySelectorAll<HTMLElement>('[data-layout-example]').forEach(example => {
    const frame = example.querySelector<HTMLIFrameElement>('iframe')!;
    const readout = example.querySelector<HTMLElement>('[data-readout]')!;
    const resting = readout.textContent;
    followPageTheme(frame);
    let layers = false;
    const send = () => {
      frame.contentWindow?.postMessage({ type: 'ds1-layout-layers', on: layers, phone: example.hasAttribute('data-phone') }, location.origin);
    };
    frame.addEventListener('load', send);
    window.addEventListener('message', event => {
      if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
      if (event.data?.type === 'ds1-example-ready') send();
      if (event.data?.type === 'ds1-layout-inspect') readout.textContent = event.data.text || resting;
    });
    onChoice(example.querySelector('[data-preview-width]'), value => { example.toggleAttribute('data-phone', value === 'phone'); send(); });
    example.addEventListener('example-device-change', send);
    const layersButton = example.querySelector<HTMLButtonElement>('[data-preview-layers]')!;
    layersButton.addEventListener('click', () => {
      layers = !layers;
      layersButton.setAttribute('aria-pressed', String(layers));
      layersButton.parentElement!.toggleAttribute('active', layers);
      example.toggleAttribute('data-layers', layers);
      send();
    });
  });
</script>
<style is:global>
  .layout-example { --layout-unit: calc(20px * var(--sf, 1)); margin-block: var(--layout-unit) calc(2 * var(--layout-unit)); color: var(--text-color); font-size: 14px; line-height: var(--layout-unit); }
  .layout-example .layout-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: calc(var(--layout-unit) / 2) var(--layout-unit); padding-block: calc(var(--layout-unit) / 2); }
  .layout-example .layout-toolbar a { padding: 0 4px; color: inherit; }
  .layout-example .layout-toolbar-end { display: flex; align-items: center; gap: calc(4px * var(--sf, 1)); margin-inline-start: auto; }
  .layout-example .layout-toolbar a:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; }
  .layout-example .layout-stage { padding: var(--layout-unit); background: var(--ds-fill); }
  .layout-example .layout-readout { min-height: calc(2 * var(--layout-unit)); margin: calc(10px * var(--sf, 1)) 0 0; }
  .layout-example .layout-inside { display: grid; grid-template-columns: repeat(auto-fill, calc(12 * var(--layout-unit))); gap: 0 var(--layout-unit); margin: 0 0 calc(10px * var(--sf, 1)); }
  .layout-example .layout-inside ul { margin: 0; padding: 0; list-style: none; }
  .layout-example .layout-inside li { margin: 0; }
  .layout-example .layer-name { color: var(--ds-text-color-muted); }
  .layout-example .layer-name .layer-swatch { flex: none; margin-block-end: calc(3px * var(--sf, 1)); }
  .layout-example .layer-swatch { width: 10px; height: 10px; border-radius: 2px; background: var(--swatch); }
  .layout-example [data-layer='4'] { --swatch: var(--pink); }
  .layout-example [data-layer='3'] { --swatch: var(--zenith-blue); }
  .layout-example [data-layer='2'] { --swatch: var(--apple-green); }
</style>
