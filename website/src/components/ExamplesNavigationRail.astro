---
const { sidebar } = Astro.locals.starlightRoute;
type Entry = { label: string; href?: string; entries?: Entry[] };
// App navigation only: reuse existing drawings without adding component icons to DS1.
const icons: Record<string, string> = {
  Colours: 'sun', Fonts: 'text', Languages: 'globe', Formatting: 'text', Theming: 'sun',
  Prose: 'page-note', Feedback: 'info', Keys: 'keyboard', Device: 'phone', Scaling: '1xgrid', Preferences: 'settings', Pricing: 'money',
  Avatar: 'avatar', Button: 'block-button', Card: 'page', Chart: 'block-page-progress', Checkbox: 'check', Cycle: 'refresh',
  'Empty state': 'page', Gap: 'block-divider', Icon: 'app', Image: 'image', Input: 'block-forms', Link: 'link', Message: 'block-banner',
  Progress: 'block-page-progress', Stat: 'money', Switch: 'toggle', Tag: 'tag', Text: 'text', Tooltip: 'info',
  Accordion: 'block-accordion', Calendar: 'calendar', Bento: '4x4', Carousel: 'block-logo-marquee', Context: 'menu', Form: 'block-forms',
  List: 'lists', Matrix: '4x4', Row: 'list-line', Select: 'chevron-down', Sidebar: 'window', Table: 'table', 'Table of contents': 'lists', Tabs: 'block-tabs',
  Container: 'block-group', Document: 'page-note', Footer: 'block-section', Grid: '1xgrid', Header: 'block-heading', Overlay: 'duplicate', Page: 'page', Panel: 'window',
  Examples: 'app', Native: 'phone', 'Email kit': 'page', 'Film kit': 'image',
};
function flatten(entries: Entry[]): { name: string; href: string; marker?: string; icon: string }[] {
  return entries.flatMap(entry => {
    const layer = entry.label.match(/^([1-4]) (Root|Core|Unit|Page)$/);
    const href = entry.href ?? (layer ? `/${layer[1]}-${layer[2].toLowerCase()}/overview/` : undefined);
    return [...(href ? [{ name: entry.label, href, marker: layer?.[1], icon: icons[entry.label] ?? 'book' }] : []), ...flatten(entry.entries ?? [])];
  });
}
const entries = flatten(sidebar);
---
<nav class="examples-navigation-rail" aria-label="Documentation shortcuts">
  {entries.map(entry => <a href={entry.href} aria-label={entry.name} data-tooltip={entry.name} data-rail-layer={entry.marker} aria-current={entry.name === 'Examples' ? 'page' : undefined}>
    {entry.marker ? <span aria-hidden="true">{entry.marker}</span> : <ds-icon type={entry.icon} aria-hidden="true" />}
  </a>)}
</nav>
<script>
  import '../../../DS1/2-core/ds-icon';
  import '../../../DS1/0-face/tooltips';
  import { readAppComponents } from '../lib/app-navigation';
  const rail = document.querySelector<HTMLElement>('.examples-navigation-rail');
  window.addEventListener('ds1-navigation-auth', event => {
    const detail = (event as CustomEvent).detail;
    if (detail.loading) return;
    rail?.querySelectorAll('[data-private-rail]').forEach(link => link.remove());
    for (const component of readAppComponents(detail)) {
      const heading = rail?.querySelector(`[data-rail-layer="${component.layer}"]`);
      if (!heading) continue;
      const link = document.createElement('a');
      link.href = component.href;
      link.dataset.privateRail = '';
      link.dataset.tooltip = component.name;
      link.setAttribute('aria-label', component.name);
      const icon = document.createElement('ds-icon');
      icon.setAttribute('type', 'app');
      icon.setAttribute('aria-hidden', 'true');
      link.append(icon);
      let next = heading.nextElementSibling;
      while (next && !next.hasAttribute('data-rail-layer') && (next.getAttribute('aria-label') ?? '').localeCompare(component.name, 'en') < 0) next = next.nextElementSibling;
      rail!.insertBefore(link, next);
    }
  });
</script>
<style>
  .examples-navigation-rail { display: none; }
  @media (min-width: 769px) {
    .examples-navigation-rail { display: flex; flex-direction: column; width: var(--site-unit); }
    .examples-navigation-rail :global(a) { display: flex; flex: none; align-items: flex-end; justify-content: center; width: var(--site-unit); height: var(--site-unit); color: inherit; text-decoration: none; font-size: calc(14px * var(--sf, 1)); line-height: calc(16px * var(--sf, 1)); }
    .examples-navigation-rail :global(a:hover) { background: var(--ds-fill); }
    .examples-navigation-rail :global(a[aria-current]) { color: var(--sharp-blue); background: var(--ds-fill); }
    .examples-navigation-rail :global(a[data-private-rail]) { color: var(--ds-text-color-muted); }
    .examples-navigation-rail :global(a:focus-visible) { outline: 1px solid currentColor; outline-offset: -1px; }
    .examples-navigation-rail :global(ds-icon) { width: calc(16px * var(--sf, 1)); height: calc(16px * var(--sf, 1)); }
  }
</style>
