---
// One palette, named by colour and sorted by hue, the inks after it; light and dark on two tabs.
// The colours and their pastel, dark and dim versions come from DS1/1-root/palette.ts, which also writes them
// into the CLASSless stylesheet. Where each colour is used is in the design-system-1 skill.


import { palette as readPalette } from '../../../DS1/1-root/palette';
const colours = readPalette().map(c => ({ ...c, darkPastel: c.dim }));
const palette = colours.filter(c => !c.ink);
const inks = colours.filter(c => c.ink);
---
    <div class="colours not-content" data-ds-not-prose>
      <div class="colours-bar"><ds-tabs class="mode-tabs" aria-label="Mode"><ds-button control="host" role="tab" id="tab-light" aria-controls="light" aria-selected="true" active>Light</ds-button><ds-button control="host" role="tab" id="tab-dark" aria-controls="dark" aria-selected="false" tabindex="-1">Dark</ds-button></ds-tabs></div>
      {[['light', 'Light'], ['dark', 'Dark']].map(([mode]) => (
        <div id={mode} class={`mode ${mode}`} role="tabpanel" aria-labelledby={`tab-${mode}`} hidden={mode === 'dark'}>
          <section>
            <h2>Palette</h2>
            <ul class="swatches">{palette.map(c => {
              const [main, soft] = mode === 'light' ? [c.hex, c.pastel] : [c.dark, c.darkPastel];
              return <li class="swatch"><b>{c.name}</b><span class="swatch-pair"><i style={`background:${main}`} data-tooltip={`${mode === 'light' ? c.name : `${c.name} dark`} ${main}`}></i><i style={`background:${soft}`} data-tooltip={`${mode === 'light' ? c.pastelName : `${c.name} dim`} ${soft}`}></i></span></li>;
            })}</ul>
          </section>
          <section>
            <h2>Inks</h2>
            <ul class="swatches inks">{inks.map(c => { const v = mode === 'light' ? c.hex : c.dark; return <li class="swatch"><b>{c.name}</b><span class="swatch-one"><i style={`background:${v}`} data-tooltip={`${c.name} ${v}`}></i></span></li>; })}</ul>
          </section>
        </div>
      ))}
      <script>
        // Each swatch names its colour and hex in Design system 1's tooltip.
        import '../../../DS1/0-face/tooltips';
      </script>
      <script is:inline>
        // ds-tabs moves between the tabs with the arrow keys; each tab shows its own panel.
        const tabs = [...document.querySelectorAll('.mode-tabs [role=tab]')];
        const show = tab => tabs.forEach(t => { const on = t === tab; t.setAttribute('aria-selected', on); t.toggleAttribute('active', on); t.tabIndex = on ? 0 : -1; document.getElementById(t.getAttribute('aria-controls')).hidden = !on; });
        tabs.forEach(tab => tab.addEventListener('click', () => show(tab)));
      </script>
    </div>

<style>
      /* On the 20px square: a swatch is eight squares wide, light and dark halves of four, three squares high; 14px text on 20px lines. */
      .colours { padding-bottom: 80px; }
      .colours section { margin-top: 40px; }
      .colours h2 { margin: 0 0 20px; font-size: 14px; line-height: 20px; font-weight: 500; letter-spacing: 0; }
      .swatches { display: grid; grid-template-columns: repeat(auto-fill, 160px); gap: 20px; margin: 0; padding: 0; list-style: none; }
      .swatch { font-size: 14px; line-height: 20px; }
      .swatch-pair { display: grid; grid-template-columns: 1fr 1fr; height: 60px; margin: 4px 0; border-radius: 4px; overflow: hidden; }
      .swatch b { display: block; font-weight: 500; }
      .inks { grid-template-columns: repeat(auto-fill, 80px); }
      .inks .swatch b { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .swatch-one { display: block; height: 40px; margin: 4px 0; border-radius: 4px; overflow: hidden; }
      .swatch-one i, .swatch-pair i { display: block; height: 100%; }
      .hexes { display: grid; grid-template-columns: 80px 80px; }
      /* The title small, and Light and Dark as one split button at the right, both on one 20px row. */
      .colours-bar { display: flex; align-items: center; justify-content: space-between; height: 20px; margin-top: 40px; padding: 0 20px; }
      .colours-bar h1 { margin: 0; font-size: 14px; line-height: 20px; font-weight: 500; letter-spacing: 0; }
      .mode { margin-top: 20px; padding: 0 20px 40px; }
      .mode.dark { background: #1e1e1e; color: #e6e6e6; }
      .mode.dark .swatch code { color: #b3b3b3; }
      .mode section:first-child { padding-top: 20px; margin-top: 0; }
      .swatch code { display: block; font-size: 12px; line-height: 20px; color: var(--muted); }

.colours-bar { margin-top: 0; padding: 0; justify-content: flex-start; }
.mode { padding-inline: 0; }
</style>