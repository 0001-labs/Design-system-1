---
// Every shared interface icon, by name, in the catalogue's order. A cell is
// the icon's SVG as a download; nothing else to choose or set.
import { scopedSvg } from '../lib/icons/svgView';
import icons from '../lib/icons/interface-catalog.json';

// Shown in the page's ink so every icon reads the same in light and dark: a
// near-black neutral becomes currentColor and a white full-frame backing
// rect is dropped. Colour that is part of a drawing stays, and the download
// remains the untouched source.
const dark = (value: string) => {
  const hex = value.toLowerCase() === 'black' ? '000000' : value.replace('#', '');
  const full = hex.length === 3 ? [...hex].map(c => c + c).join('') : hex;
  if (!/^[0-9a-f]{6}$/i.test(full)) return false;
  const [r, g, b] = [0, 2, 4].map(i => parseInt(full.slice(i, i + 2), 16));
  return Math.max(r, g, b) - Math.min(r, g, b) < 24 && Math.max(r, g, b) < 100;
};
const themed = (svg: string) => svg
  .replace(/<rect width="16" height="16" fill="(?:white|#fff|#ffffff)"[^>]*\/?>/gi, '')
  .replace(/\b(fill|stroke|stop-color)="([^"]+)"/g, (all, attribute, value) => dark(value) ? `${attribute}="currentColor"` : all);
---
<div class="icon-table not-content" data-ds-not-prose>
  <p class="icon-count">{icons.length} icons · 16 × 16 · click one to download its SVG</p>
  <ul class="icons">{icons.map(icon => (
    <li><a href={icon.url} download={`${icon.key}.svg`} title={`${icon.name} · ${icon.key}.svg`}>
      <span class="icon-tile" set:html={scopedSvg(themed(icon.svg), 'table-' + icon.key)} />
      <span class="icon-name">{icon.name}</span>
    </a></li>
  ))}</ul>
</div>

<style>
  /* On the 20px square: a cell is four squares wide, a three-square tile and one line of 14px text. */
  .icon-table { padding: 40px 0 80px; }
  .icon-count { margin: 0 0 20px; font-size: 14px; line-height: 20px; }
  .icons { display: grid; grid-template-columns: repeat(auto-fill, 80px); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .icons a { display: block; color: inherit; text-decoration: none; font-size: 14px; line-height: 20px; }
  .icon-tile { display: grid; place-items: center; height: 60px; border-radius: 4px; background: color-mix(in srgb, currentColor 6%, transparent); }
  .icon-tile :global(svg) { width: 32px; height: 32px; }
  .icons a:hover .icon-tile { background: color-mix(in srgb, currentColor 12%, transparent); }
  .icons a:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; border-radius: 4px; }
  .icon-name { display: block; margin-top: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
</style>
