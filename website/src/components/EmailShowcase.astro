---
import { emailExamples } from '../lib/email-examples';
---
<div class="email-showcase">
  <div class="email-controls">
    <label>Example <ds-select><select data-example>{emailExamples.map(e => <option value={e.id}>{e.label}</option>)}</select></ds-select></label>
    <label>Width <ds-select><select data-width><option value="800">Desktop</option><option value="380">Phone</option></select></ds-select></label>
    <label>Paper <ds-select><select data-theme><option value="light">Light</option><option value="dark">Dark</option></select></ds-select></label>
  </div>
  <div class="email-preview"><iframe title="Email design preview" sandbox="allow-same-origin" srcdoc={emailExamples[0].html} /></div>
  <details><summary>Plain text</summary><pre data-text>{emailExamples[0].text}</pre></details>
  <details><summary>Generated HTML</summary><pre data-html>{emailExamples[0].html}</pre></details>
  <script type="application/json" data-emails set:html={JSON.stringify(emailExamples).replace(/</g, '\\u003c')} />
</div>
<script>
  document.querySelectorAll<HTMLElement>('.email-showcase').forEach(root => {
    const examples = JSON.parse(root.querySelector('[data-emails]')!.textContent!) as {id:string;html:string;text:string}[];
    const example = root.querySelector<HTMLSelectElement>('[data-example]')!;
    const width = root.querySelector<HTMLSelectElement>('[data-width]')!;
    const theme = root.querySelector<HTMLSelectElement>('[data-theme]')!;
    const frame = root.querySelector('iframe')!;
    const update = () => {
      const selected = examples.find(e => e.id === example.value)!;
      frame.style.width = `${width.value}px`;
      // Force only the preview's media query. Sent HTML keeps system dark mode.
      frame.srcdoc = selected.html.replaceAll('(prefers-color-scheme:dark)', theme.value === 'dark' ? '(min-width:0px)' : '(max-width:0px)');
      root.querySelector('[data-text]')!.textContent = selected.text;
      root.querySelector('[data-html]')!.textContent = selected.html;
    };
    [example, width, theme].forEach(control => control.addEventListener('change', update));
    update();
  });
</script>
<style>
  .email-controls { display:flex;flex-wrap:wrap;gap:20px;margin:20px 0;font-size:14px;line-height:20px; }
  label { display:flex;gap:10px;align-items:center; }
  .email-preview { overflow:auto;max-width:100%; }
  iframe { display:block;width:800px;height:1000px;border:0;margin:0 auto; }
  details { margin-top:20px; }
  summary { cursor:pointer; }
  pre { max-height:400px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere; }
</style>
