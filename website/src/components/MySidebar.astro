---
const { sidebar } = Astro.locals.starlightRoute;
---
<div class="docs-sidebar-shell">
  <ds-sidebar id="docs-navigation" label="Documentation" disclosure-position="start" expand-icon="chevron-down" collapse-icon="chevron-up" data-groups={JSON.stringify(sidebar)}>
    <div slot="header" class="docs-sidebar-header">
      <section id="workspace" hidden aria-label="Company workspace">
        <div class="workspace-heading"><button id="workspace-toggle" class="ds-row" type="button" aria-label="Expand workspace" aria-expanded="false" aria-controls="workspace-libraries">
          <ds-avatar id="workspace-avatar" initial="?" aria-hidden="true"></ds-avatar>
          <span id="workspace-name">My company</span>
          <ds-icon id="workspace-chevron" type="chevron-down" aria-hidden="true"></ds-icon>
          </button><ds-button control="slotted" icon id="workspace-add"><button type="button" aria-label="New library"><ds-icon type="plus" aria-hidden="true"></ds-icon></button></ds-button>
        </div>
        <ds-sidebar id="workspace-libraries" label="Your design systems" hidden></ds-sidebar>
        <p id="workspace-error" role="alert" hidden></p>
      </section>
      <ds-button control="slotted" icon class="docs-sidebar-close">
        <button id="sidebar-close-btn" type="button" aria-label="Close navigation menu"><ds-icon type="close"></ds-icon></button>
      </ds-button>
    </div>
      <section id="private-app-navigation" slot="private-app" hidden aria-label="Internal App components">
        <button id="private-app-toggle" class="ds-row" type="button" aria-expanded="false" aria-controls="private-app-links"><ds-icon type="chevron-down" aria-hidden="true"></ds-icon><span>App</span></button>
        <div id="private-app-links" hidden></div>
      </section>
    <div slot="footer" class="docs-sidebar-footer">
      <ds-button href="https://github.com/0001-labs/Design-system-1">GitHub</ds-button>
      <a id="docs-account" href="/app/signin" aria-label="Sign in">
        <span data-account-signin>Sign in</span>
        <ds-avatar data-account-avatar icon="avatar" aria-hidden="true" hidden></ds-avatar>
      </a>
    </div>
  </ds-sidebar>
</div>

<script>
  import '../../../DS1/3-unit/ds-sidebar';
  import '../../../DS1/2-core/ds-tag';
  import { hideSignedInLibraryEntry } from '../lib/sidebar-visibility';
  import { connectAppNavigation } from '../lib/app-navigation';
  import '../../../DS1/1-root/row.css';
  import '../../../DS1/2-core/ds-avatar';
  import { translate } from '../../../DS1/0-face/i18n';
  import { LAYERS } from '../../../shared/component-directory';
  import { libraryWorkspaceHref, type LibraryNavigation } from '../../../shared/library-navigation';
  import type { SidebarItem } from '../../../DS1/3-unit/ds-sidebar';
  const navigation = document.querySelector('ds-sidebar#docs-navigation')!;
  type Entry = { label: string; href?: string; isCurrent?: boolean; entries?: Entry[] };
  const groups: Entry[] = JSON.parse(navigation.dataset.groups ?? '[]');
  let library: LibraryNavigation | null = null;
  const collapsed = new Set<string>();
  let signedIn = document.documentElement.hasAttribute("data-signed-in");
  const translationKeys: Record<string, string> = {
    'Start Here': 'startHere', 'Built-ins': 'builtIns', '1 Root': 'root', '2 Core': 'core', '3 Unit': 'unit', '4 Page': 'page',
    Introduction: 'introduction', 'Manual Setup': 'manualSetup', Theming: 'theming', 'Mobile Detection': 'mobileDetection',
    Styling: 'styling', Fonts: 'fonts', Button: 'button', Text: 'text', Link: 'link', Icon: 'icon', Tooltip: 'tooltip',
    Navigation: 'navigation', List: 'list', Panel: 'panel', Card: 'card', Layout: 'layout', Grid: 'grid',
  };
  function label(text: string): string {
    const key = translationKeys[text] ?? text;
    const translated = translate(key);
    return translated === key ? text : translated;
  }

  const overviewPaths: Record<string, string> = {
    '1 Root': '/1-root/overview/', '2 Core': '/2-core/overview/',
    '3 Unit': '/3-unit/overview/', '4 Page': '/4-page/overview/',
    Icon: '/2-core/icon/',
  };
  function rows(entries: Entry[], depth = 0, parent = ''): SidebarItem[] {
    return entries.flatMap((entry, index) => {
      if (signedIn && (entry.label === 'Start Here' || hideSignedInLibraryEntry(entry))) return [];
      if (entry.href === '/app/libraries' && !signedIn) return [];
      const href = (entry.href === "/app/libraries" ? "/classless/libraries/" : entry.href) ?? (entry.entries ? overviewPaths[entry.label] : undefined);
      const id = href ?? `${parent}/group-${index}`;
      const item: SidebarItem = { id, label: label(entry.label), depth, href, current: href ? location.pathname.replace(/\/$/, "") === href.replace(/\/$/, "") : entry.isCurrent };
      if (!entry.entries) return [item];
      item.expanded = !collapsed.has(id);
      return [item, ...(item.expanded ? rows(entry.entries, depth + 1, id) : [])];
    });
  }
  const workspace = document.querySelector<HTMLElement>('#workspace')!;
  const workspaceToggle = document.querySelector('#workspace-toggle')!;
  const workspaceAvatar = document.querySelector('#workspace-avatar')!;
  const workspaceLibraries = document.querySelector('ds-sidebar#workspace-libraries')!;
  const workspaceAdd = document.querySelector('#workspace-add')!;
  let workspaceOpen = false;
  let workspaceName = 'My company';
  let workspaceItems: { id: string; name: string; publishedVersion: number | null }[] = [];
  let librariesLoaded = false;
  function renderWorkspace() {
    workspace.hidden = !signedIn;
    document.querySelector('#workspace-name')!.textContent = workspaceName;
    workspaceAvatar.setAttribute('initial', workspaceName.slice(0, 1).toUpperCase());
    workspaceAvatar.setAttribute('label', workspaceName);
    workspaceToggle.setAttribute('aria-expanded', String(workspaceOpen));
    workspaceToggle.setAttribute('aria-label', `${workspaceOpen ? 'Collapse' : 'Expand'} ${workspaceName}`);
    document.querySelector('#workspace-chevron')!.setAttribute('type', workspaceOpen ? 'chevron-up' : 'chevron-down');
    workspaceLibraries.hidden = !workspaceOpen;
    workspaceLibraries.items = [
      { id: 'workspace-all', label: 'My libraries', href: '/classless/libraries/' },
      { id: 'workspace-base', label: 'Design system 1', meta: 'Built-in', href: '/start-here/overview/' },
      ...workspaceItems.map(item => ({ id: `workspace-${item.id}`, label: item.name, href: libraryWorkspaceHref({ ...item, component: '/2-core/button/', view: 'overview' }), current: item.id === library?.id })),
      ...(!librariesLoaded ? [{ id: 'workspace-loading', label: 'Loading libraries…', disabled: true }] : []),
    ];
  }
  workspaceToggle.addEventListener('click', () => { workspaceOpen = !workspaceOpen; renderWorkspace(); });
  workspaceAdd.addEventListener('click', () => {
    if (!signedIn || workspaceAdd.hasAttribute('disabled')) return;
    document.querySelector<HTMLIFrameElement>('#navigation-auth')?.contentWindow?.postMessage({ type: 'ds1:create-library' }, location.origin);
  });
  const account = document.querySelector<HTMLAnchorElement>('#docs-account')!;
  const signInLabel = account.querySelector<HTMLElement>('[data-account-signin]')!;
  const avatar = account.querySelector<HTMLElement>('[data-account-avatar]')!;
  function renderAccount() {
    account.href = signedIn ? '/app/profile' : '/app/signin';
    account.setAttribute('aria-label', signedIn ? 'Profile' : 'Sign in');
    signInLabel.hidden = signedIn;
    avatar.hidden = !signedIn;
  }
  function renderNavigation() {
    navigation.label = library ? `${library.name} navigation` : 'Documentation';
    const items: SidebarItem[] = library ? [
      { id: 'base-system', label: 'Design system 1', href: '/start-here/overview/' },
      { id: 'library-overview', label: library.name, href: libraryWorkspaceHref({ ...library, view: 'overview' }), current: library.view === 'overview' },
      ...LAYERS.flatMap(layer => {
        const id = `library-layer-${layer.number}`;
        const expanded = !collapsed.has(id);
        return [{ id, label: `${layer.number} ${layer.name}`, expanded }, ...(expanded ? layer.entries.map(entry => ({
          id: entry.href, label: entry.name, depth: 1, href: libraryWorkspaceHref({ ...library!, view: undefined }, entry.href), current: !library!.view && library!.component === entry.href,
        })) : [])];
      }),
    ] : rows(groups);
    const pageIndex = items.findIndex(item => item.id === '/4-page/overview/' || item.id === 'library-layer-4');
    if (pageIndex >= 0) {
      let last = pageIndex;
      while (last + 1 < items.length && (items[last + 1].depth ?? 0) > 0) last++;
      items[last].afterSlot = 'private-app';
    }
    navigation.items = items;
  }
  connectAppNavigation(document.querySelector<HTMLElement>('#private-app-navigation')!);
  renderAccount();
  renderWorkspace();
  renderNavigation();
  window.addEventListener('ds1-library-navigation', event => {
    library = (event as CustomEvent).detail.library;
    renderWorkspace();
    renderNavigation();
  });
  navigation.addEventListener('sidebar-activate', event => {
    const id = (event as CustomEvent).detail.id;
    if (!library || (id !== 'library-overview' && !LAYERS.some(layer => layer.entries.some(entry => entry.href === id)))) return;
    const frame = document.querySelector<HTMLIFrameElement>('#classless-app');
    if (!frame?.contentWindow) return;
    event.preventDefault();
    frame.contentWindow.postMessage(id === 'library-overview' ? { type: 'ds1:library-overview' } : { type: 'ds1:library-component', component: id }, location.origin);
  });
  window.addEventListener("hashchange", () => { renderNavigation(); });
  window.addEventListener("ds1-navigation-auth", event => {
    const detail = (event as CustomEvent).detail;
    signedIn = detail.authenticated;
    if (!signedIn) { library = null; workspaceOpen = false; }
    workspaceName = typeof detail.companyName === 'string' && detail.companyName.trim() ? detail.companyName : 'My company';
    workspaceItems = signedIn && Array.isArray(detail.libraries) ? detail.libraries.filter((item: any) => typeof item.id === 'string' && typeof item.name === 'string') : [];
    librariesLoaded = detail.librariesLoaded === true;
    workspaceAdd.toggleAttribute('disabled', detail.creating === true);
    const error = document.querySelector<HTMLElement>('#workspace-error')!;
    error.hidden = !signedIn || !detail.creationError;
    error.textContent = detail.creationError ?? '';
    renderWorkspace(); renderNavigation(); renderAccount();
  });
  window.addEventListener("translations-ready", () => { renderNavigation(); });
  window.addEventListener("language-changed", () => { renderNavigation(); });
  // Replay the authenticated summary after all sidebar listeners are ready.
  document.querySelector<HTMLIFrameElement>('#navigation-auth')?.contentWindow?.postMessage({ type: 'ds1:navigation-auth-request' }, location.origin);
  navigation.addEventListener('sidebar-toggle', event => {
    const { id, expanded } = (event as CustomEvent).detail;
    if (expanded) collapsed.delete(id); else collapsed.add(id);
    renderNavigation();
    navigation.updateComplete.then(() => navigation.focusItem(id));
  });
</script>

<style>
  .docs-sidebar-shell { display: flex; flex: 1; min-height: 0; height: 100%; padding: var(--site-unit); overflow: hidden; }
  ds-sidebar { width: 100%; height: 100%; }
  .docs-sidebar-header { display: flex; flex-direction: column; gap: 20px; }
  .docs-sidebar-close { display: none; align-self: flex-end; }
  .docs-sidebar-footer { display: flex; align-items: center; gap: calc(var(--site-unit) / 2); height: calc(2 * var(--site-unit)); border-top: 1px solid var(--ds1-docs-header-border); font-size: calc(10px * var(--sf, 1)); }
  #private-app-navigation[hidden], #private-app-links[hidden], #workspace[hidden], #workspace-libraries[hidden] { display: none; }
  #workspace { flex: none; }
  #private-app-toggle { width: 100%; text-align: left; }
  #private-app-links { padding-inline-start: var(--site-unit); }
  #private-app-links :global(a) { width: 100%; text-decoration: none; }
  #private-app-links :global(ds-tag) { --ds-tag-accent: var(--ds-pink); }
  .workspace-heading { display: flex; align-items: flex-end; }
  #workspace-toggle { flex: 1; width: auto; min-width: 0; }
  #workspace-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #workspace-libraries { height: auto; max-height: calc(12 * var(--site-unit)); padding-inline-start: calc(var(--site-unit) / 2); box-sizing: border-box; }
  #workspace-error { color: var(--ds-danger-color); font-size: var(--ds-type-size-small); margin: 0; }
  #docs-account { display: inline-flex; align-items: center; justify-content: center; margin-left: auto; min-width: var(--site-unit); height: var(--site-unit); color: inherit; text-decoration: none; }
  #docs-account:hover { text-decoration: underline; }
  #docs-account:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #docs-account [hidden] { display: none !important; }
  @media (max-width: 768px) { .docs-sidebar-close { display: block; } }
</style>
