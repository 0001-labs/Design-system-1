<section id="private-component-workspace" class="private-component-workspace" hidden aria-label="Internal component documentation">
  <p id="private-component-status" role="status">Checking access…</p>
  <iframe id="private-component-frame" title="Internal component documentation" hidden></iframe>
</section>

<script>
  import { readAppComponents } from '../lib/app-navigation';
  const workspace = document.querySelector<HTMLElement>('#private-component-workspace')!;
  const frame = document.querySelector<HTMLIFrameElement>('#private-component-frame')!;
  const status = document.querySelector<HTMLElement>('#private-component-status')!;
  const context = document.querySelector<HTMLElement>('#private-component-context');
  const requested = new URLSearchParams(location.search).get('internal');
  if (requested !== null) {
    workspace.hidden = false;
    const sendTheme = () => frame.contentWindow?.postMessage({
      type: 'ds1:docs-theme', scale: getComputedStyle(document.documentElement).getPropertyValue('--sf').trim() || '1', theme: document.documentElement.classList.contains('dark-theme') ? 'dark' : 'light',
    }, location.origin);
    frame.addEventListener('load', sendTheme);
    window.addEventListener('theme-changed', sendTheme);
    new MutationObserver(sendTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
    window.addEventListener('ds1-navigation-auth', event => {
      const detail = (event as CustomEvent).detail;
      if (detail.loading) { status.hidden = false; status.textContent = 'Checking access…'; return; }
      const component = readAppComponents(detail).find(item => new URL(item.href, location.origin).searchParams.get('internal') === requested);
      if (context) context.hidden = !component;
      if (!component) {
        frame.hidden = true;
        frame.removeAttribute('src');
        status.hidden = false;
        status.textContent = detail.authenticated ? 'This component is available only to the owner.' : 'Sign in with the owner account to view this component.';
        return;
      }
      document.title = `${component.name} — Design system 1`;
      frame.title = `${component.name} documentation`;
      const src = `/private-app/?component=${encodeURIComponent(requested)}`;
      if (frame.getAttribute('src') !== src) frame.src = src;
      frame.hidden = false;
      status.hidden = true;
    });
    document.querySelector<HTMLIFrameElement>('#navigation-auth')?.contentWindow?.postMessage({ type: 'ds1:navigation-auth-request' }, location.origin);
  }
</script>

<style>
  .private-component-workspace { height: 100%; min-width: 0; background: var(--ds1-docs-content-bg); }
  .private-component-workspace[hidden], iframe[hidden], p[hidden] { display: none; }
  iframe { display: block; width: 100%; height: 100%; border: 0; background: var(--ds1-docs-content-bg); }
  p { margin: 0; padding: var(--site-unit); color: var(--ds-text-color-muted); font-size: var(--ds-type-size-default); line-height: var(--site-unit); }
</style>
