---
import MyHeader from '../components/MyHeader.astro';
import MySidebar from '../components/MySidebar.astro';
import MyHead from '../components/MyHead.astro';
import ClasslessWorkspace from '../components/ClasslessWorkspace.astro';
import LandingPage from '../components/LandingPage.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isHome = pathname === '';
const isTool = ['/2-core/icon/collection', '/colours', '/components'].includes(pathname);
const classlessMode = pathname === '/classless/editor' ? 'editor'
  : pathname === '/classless/libraries' ? 'libraries' : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title || 'Design system 1'}</title>
    <MyHead />
    <link rel="icon" type="image/svg+xml" href="/icons/design-system-1.svg" />
  </head>
  <body>
    <!-- Header -->
    <MyHeader landing={isHome} />

    <!-- Main Container with Sidebar and Content -->
    <div class:list={['main-container', { 'main-container--home': isHome }]}>
      <!-- Sidebar -->
      {!isHome && <aside id="sidebar" class="sidebar" aria-label="Documentation navigation">
        <MySidebar />
      </aside>}

      <!-- On a phone the same navigation opens in Design system 1's dialog, filling the screen. -->
      {!isHome && <ds-overlay id="mobile-navigation" type="screen"><dialog id="mobile-navigation-panel" aria-label="Documentation" data-ds-overlay-flush></dialog></ds-overlay>}

      <!-- Sidebar gap (desktop only) -->
      {!isHome && <div class="sidebar-gap"></div>}

      <!-- Main Content -->
      <main aria-label="Documentation content" class:list={['main-content', { 'main-content--app': classlessMode, 'main-content--home': isHome, 'main-content--tools': isTool }]}>
        {isHome ? <LandingPage /> : classlessMode ? <ClasslessWorkspace mode={classlessMode} /> : <slot />}
      </main>
    </div>

    <style is:global>
      * {
        font-family: 'GT-America-Standard-Regular', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--ds1-docs-sidebar-bg);
        color: var(--ds1-docs-header-text);
      }

      body {
        overflow-x: hidden;
      }

      /* Main container */
      .main-container {
        display: flex;
        height: calc(100dvh - var(--site-header-height));
        overflow: hidden;
      }

      /* Sidebar */
      .sidebar {
        /* Fourteen squares, its hairline inside the last one. */
        width: 280px;
        min-width: 280px;
        box-shadow: inset -1px 0 var(--ds1-docs-header-border);
        overflow-y: auto;
        background: var(--ds1-docs-sidebar-bg);
        z-index: 100;
      }

      /* Sidebar gap */
      .sidebar-gap {
        width: 20px;
        min-width: 20px;
        height: 100%;
        background: var(--ds1-docs-sidebar-bg);
        box-shadow: inset -1px 0 var(--ds1-docs-header-border);
      }

      .docs-tool { container: tool / inline-size; min-width: 0; }
      .main-content--tools .sl-container { max-width: none; }
      .main-content--tools .content-panel { max-width: none; }
      .main-content--tools .right-sidebar-container { display: none; }
      /* Main content */
      .main-content {
        flex: 1;
        min-width: 0;
        overflow-y: auto;
      }

      .main-content--app {
        padding: 0;
        overflow: hidden;
        background: var(--ds1-docs-content-bg);
      }

      .main-content--home {
        background: var(--ds1-docs-content-bg);
        overflow: visible;
      }

      .main-container.main-container--home {
        display: block;
        height: auto;
        overflow: visible;
      }

      #mobile-navigation { --ds-overlay-paper: var(--ds1-docs-sidebar-bg); }

      /* Keep scroll geometry stable; only the thumb changes while active. */
      :is(.sidebar, .main-content, .right-sidebar, .right-sidebar-panel) {
        --docs-scroll-thumb: transparent;
        scrollbar-width: thin;
        scrollbar-color: var(--docs-scroll-thumb) transparent;
      }
      :is(.sidebar, .main-content, .right-sidebar, .right-sidebar-panel):is([data-scrolling], :focus-visible) {
        --docs-scroll-thumb: var(--ds-grey);
      }
      :is(.sidebar, .main-content, .right-sidebar, .right-sidebar-panel)::-webkit-scrollbar { width: calc(var(--site-unit) / 2); height: calc(var(--site-unit) / 2); }
      :is(.sidebar, .main-content, .right-sidebar, .right-sidebar-panel)::-webkit-scrollbar-track { background: transparent; }
      :is(.sidebar, .main-content, .right-sidebar, .right-sidebar-panel)::-webkit-scrollbar-thumb { background: var(--docs-scroll-thumb); border-radius: var(--radius); }

      /* Mobile Responsive Styles */
      @media (max-width: 768px) {
        .main-container {
          height: calc(100dvh - var(--site-header-height));
        }

        .sidebar {
          display: none;
        }

        .sidebar-gap {
          display: none;
        }

        .main-content {
          width: 100%;
        }
      }

      /* Tablet adjustments */
      @media (max-width: 1024px) and (min-width: 769px) {
        .sidebar {
          width: 240px;
          min-width: 240px;
        }
      }
    </style>

    <script>
      import '../../../DS1/4-page/ds-overlay';
      import type { Overlay } from '../../../DS1/4-page/ds-overlay';
      const scrollTimers = new WeakMap<Element, ReturnType<typeof setTimeout>>();
      document.addEventListener('scroll', event => {
        const panel = event.target;
        if (!(panel instanceof HTMLElement) || !panel.matches('.sidebar, .main-content, .right-sidebar, .right-sidebar-panel')) return;
        panel.setAttribute('data-scrolling', '');
        clearTimeout(scrollTimers.get(panel));
        scrollTimers.set(panel, setTimeout(() => panel.removeAttribute('data-scrolling'), 700));
      }, true);

      // One navigation: it stands in the sidebar, and on a phone the menu button
      // opens it in Design system 1's dialog, which owns the modal, its focus,
      // Escape and the close button. Closing puts it back in the sidebar.
      const sidebar = document.getElementById('sidebar');
      const navigation = document.querySelector<Overlay>('ds-overlay#mobile-navigation');
      const panel = navigation?.querySelector('dialog');
      const shell = sidebar?.querySelector<HTMLElement>('.docs-sidebar-shell');
      const menuButton = document.getElementById('mobile-menu-btn');
      const phone = window.matchMedia('(max-width: 768px)');
      document.getElementById('sidebar-close-btn')?.setAttribute('data-ds-overlay-dismiss', '');

      function restore() {
        if (shell && sidebar && shell.parentElement !== sidebar) sidebar.append(shell);
        menuButton?.setAttribute('aria-expanded', 'false');
      }
      menuButton?.addEventListener('click', () => {
        if (!navigation || !panel || !shell) return;
        if (navigation.open) { navigation.requestClose('button'); return; }
        panel.append(shell);
        menuButton.setAttribute('aria-expanded', 'true');
        void navigation.show({ immediate: true });
      });
      panel?.addEventListener('close', restore);
      shell?.addEventListener('sidebar-activate', () => { if (navigation?.open) navigation.requestClose('button'); });
      phone.addEventListener('change', () => { if (!phone.matches && navigation?.open) navigation.close(); });
    </script>
  </body>
</html>
