{
  "name": "designsystem1",
  "account_id": "ce6189d5ac975158991e207a3c4e1cd5",
  "main": "./services/src/index.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "services": [{"binding":"CONSISTENCY_WORKSPACE","service":"consistency-platform","entrypoint":"ConsistencyWorkspace"}, {"binding":"C9Y_IDENTITY","service":"0001-system","entrypoint":"ConsistencyIdentity"}],
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./website/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "LIBRARIES",
      "bucket_name": "ds-one-libraries",
      "preview_bucket_name": "ds-one-libraries-preview"
    }
  ],
  "vars": {
    "MAX_CSS_BYTES": "524288"
  },
  "routes": [{"pattern":"c9y.site/*","zone_name":"c9y.site"},
    // Specific routes win over the existing c9y.site wildcard site renderer. editor.c9y.site is the owner's
    // editor lab; neweditor.c9y.site, its first address, leads there (services/src/consistency.ts).
    { "pattern": "editor.c9y.site/*", "zone_name": "c9y.site" },
    { "pattern": "editor.c9y.site", "custom_domain": true },
    { "pattern": "neweditor.c9y.site/*", "zone_name": "c9y.site" },
    { "pattern": "neweditor.c9y.site", "custom_domain": true },
    // Consistency's app at consistency.site: its front page (the landing for anyone signed out, passed on to the
    // Pages project) and the app's own addresses. Every other address of consistency.site stays the Pages project's.
    { "pattern": "consistency.site/", "zone_name": "consistency.site" },
    { "pattern": "consistency.site/auth/*", "zone_name": "consistency.site" },
    { "pattern": "consistency.site/api/consistency/*", "zone_name": "consistency.site" },
    { "pattern": "consistency.site/api/dashboard/*", "zone_name": "consistency.site" },
    { "pattern": "consistency.site/app/*", "zone_name": "consistency.site" },
    { "pattern": "consistency.site/private-consistency/*", "zone_name": "consistency.site" },
    { "pattern": "consistency.site/icons/design-system-1.svg", "zone_name": "consistency.site" },
    // C9Y System: the System owner's private map of Consistency (services/src/c9y-system-site.ts).
    { "pattern": "system.consistency.site", "custom_domain": true },
    { "pattern": "fonts.designsystem1.com", "custom_domain": true },
    { "pattern": "icon.designsystem1.com", "custom_domain": true },
    // Play: a small site and the pages it makes (website/src/pages/play.astro).
    { "pattern": "play.designsystem1.com", "custom_domain": true },
    {
      "pattern": "designsystem1.com",
      "custom_domain": true
    },
    {
      "pattern": "www.designsystem1.com",
      "custom_domain": true
    },
    {
      "pattern": "dsone.dev/*",
      "zone_name": "dsone.dev"
    }
  ]
}
