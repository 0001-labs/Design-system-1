{
  "name": "@0001-labs/design-system-1",
  "version": "0.3.0-alpha.13",
  "description": "A component-based design system built with TypeScript and LitElement that provides reusable UI components with built-in theming, internationalization, and accessibility features.",
  "keywords": [
    "components",
    "design-system",
    "i18n",
    "lit-element",
    "theming",
    "typescript",
    "ui-kit",
    "web-components"
  ],
  "homepage": "https://designsystem1.com",
  "bugs": {
    "url": "https://github.com/0001-labs/Design-system-1/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0001-labs/Design-system-1.git"
  },
  "files": [
    "dist/",
    "DS1/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "DS1/**/*.ts",
    "dist/**/*.js"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./DS1/*": "./DS1/*",
    "./styles": "./DS1/1-root/one.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "reports:scan": "vp exec tsx scripts/component-adoption.ts",
    "reports:configure": "node scripts/configure-report-access.mjs",
    "reports:upload:local": "cd services && vp exec wrangler r2 object put ds-one-libraries-preview/reports/component-adoption.json --file ../.reports/component-adoption.json --local --config ../wrangler.jsonc",
    "reports:upload": "vp run reports:scan && cd services && vp exec wrangler r2 object put ds-one-libraries/reports/component-adoption.json --file ../.reports/component-adoption.json --remote --config ../wrangler.jsonc",
    "dev": "vp dev --host",
    "build": "vp run build:bundle",
    "check": "vp check",
    "generate:icons": "vp exec tsx scripts/generate-icons.ts",
    "build:bundle": "vp run generate:icons && vp exec tsc && vp run build:vite && vp run build:vite:min",
    "build:vite": "vp build --config vite.config.lib.ts",
    "build:vite:min": "MINIFY=true vp build --config vite.config.lib.ts",
    "build:types": "vp exec tsc --noEmit",
    "build:components": "vp run build:core && vp run build:units",
    "build:core": "vp run build:component -- DS1/2-core",
    "build:units": "vp run build:component -- DS1/3-unit",
    "build:component": "vp exec tsx scripts/build-component.ts",
    "prepublishOnly": "vp run check:versions",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "test": "vp test --passWithNoTests",
    "clean": "rm -rf node_modules web/node_modules dist",
    "docs:dev": "cd website && vp run dev",
    "icons:build": "vp exec tsx scripts/build-icon-assets.ts",
    "docs:build": "vp run icons:build && cd website && vp run build",
    "docs:preview": "cd website && vp run preview",
    "docs:deploy": "vp run site:deploy",
    "app:dev": "cd app && vp run dev",
    "app:build": "cd app && vp run build",
    "app:deploy": "vp run site:deploy",
    "test:unit": "vp test && (cd packages/css-validate && vp test) && (cd app && vp test) && (cd services && vp test)",
    "test:e2e": "cd e2e && vp exec playwright test",
    "typecheck:all": "cd packages/css-validate && vp exec tsc --noEmit && cd ../../app && vp exec tsc --noEmit && cd ../services && vp exec tsc --noEmit",
    "services:dryrun": "cd services && vp run dryrun",
    "site:build": "vp run docs:build && vp run app:build",
    "site:deploy": "vp run site:build && cd services && vp exec wrangler deploy --config ../wrangler.jsonc",
    "deploy": "vp run site:deploy",
    "check:versions": "node scripts/versions.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "vp run build:types",
    "release:sync": "node scripts/versions.mjs --write",
    "sync-sign-in": "node \"../ID 1/scripts/sync-into.mjs\" --convex convex/signIn --client app/src/signIn",
    "icons:sync-products": "vp exec tsx scripts/sync-product-icons.ts",
    "icons:check-products": "vp exec tsx scripts/sync-product-icons.ts --check",
    "icons:sync-globe": "node scripts/sync-globe.mjs",
    "icons:check-globe": "node scripts/sync-globe.mjs --check"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@lit-labs/signals": "^0.1.3",
    "jose": "5.10.0",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@ds-one/css-validate": "file:./packages/css-validate",
    "@edge-runtime/vm": "^5.0.0",
    "@hono/node-server": "^2.1.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "convex": "^1.42.3",
    "convex-test": "^0.0.54",
    "esbuild": "^0.27.0",
    "happy-dom": "^21.0.1",
    "playwright": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.17.0",
    "lit": "^3.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "convex": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.7.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  }
}
